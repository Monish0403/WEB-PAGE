<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TimberLink India | Premium Wood & Furniture Materials</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        slate: {
                            850: '#151e2e',
                            900: '#0f172a',
                        },
                        teal: {
                            400: '#2dd4bf',
                            500: '#14b8a6',
                            600: '#0d9488',
                        }
                    },
                    animation: {
                        'fade-in': 'fadeIn 0.3s ease-out',
                        'slide-in-right': 'slideInRight 0.3s ease-out forwards',
                        'slide-out-right': 'slideOutRight 0.3s ease-in forwards',
                        'slide-up': 'slideUp 0.4s ease-out',
                    },
                    keyframes: {
                        fadeIn: {
                            '0%': { opacity: '0' },
                            '100%': { opacity: '1' },
                        },
                        slideInRight: {
                            '0%': { transform: 'translateX(100%)' },
                            '100%': { transform: 'translateX(0)' },
                        },
                        slideOutRight: {
                            '0%': { transform: 'translateX(0)' },
                            '100%': { transform: 'translateX(100%)' },
                        },
                        slideUp: {
                            '0%': { transform: 'translateY(20px)', opacity: '0' },
                            '100%': { transform: 'translateY(0)', opacity: '1' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0d9488 150%);
            background-attachment: fixed;
            color: #f8fafc;
        }

        /* Glassmorphism Utilities */
        .glass-panel {
            background: rgba(30, 41, 59, 0.6);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
        }

        .glass-card {
            background: rgba(15, 23, 42, 0.5);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(45, 212, 191, 0.15);
            transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
        }

        .glass-card:hover {
            border-color: rgba(45, 212, 191, 0.5);
            box-shadow: 0 10px 40px -10px rgba(20, 184, 166, 0.4);
            transform: translateY(-4px);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.8);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(20, 184, 166, 0.5);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(20, 184, 166, 0.8);
        }

        .cart-open {
            overflow: hidden;
        }
    </style>
</head>
<body class="min-h-screen font-sans antialiased text-slate-200">

    <!-- Navigation -->
    <nav class="sticky top-0 z-40 glass-panel border-b border-slate-700/50 px-4 sm:px-8 py-4 flex justify-between items-center">
        <div class="flex items-center gap-3">
            <!-- Logo Icon -->
            <svg class="w-8 h-8 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
            <span class="text-2xl font-bold tracking-tight text-white">TimberLink <span class="text-teal-400">India</span></span>
        </div>

        <div class="flex items-center gap-6">
            <!-- Dealer Mode Toggle -->
            <label class="flex items-center gap-3 cursor-pointer group">
                <div class="flex flex-col items-end hidden sm:flex">
                    <span class="text-sm font-semibold text-slate-300 group-hover:text-teal-300 transition-colors">Dealer Portal</span>
                    <span class="text-xs text-slate-500" id="dealerStatusText">B2C Retail Mode</span>
                </div>
                <div class="relative">
                    <input type="checkbox" id="dealerToggle" class="sr-only">
                    <div class="block bg-slate-700 w-12 h-7 rounded-full transition-colors border border-slate-600" id="toggleBg"></div>
                    <div class="dot absolute left-1 top-1 bg-slate-300 w-5 h-5 rounded-full transition-transform transform shadow-md" id="toggleDot"></div>
                </div>
            </label>

            <!-- Cart Button -->
            <button id="cartBtn" class="relative p-2 rounded-xl bg-slate-800/50 hover:bg-slate-700/50 border border-slate-600/50 transition-colors">
                <svg class="w-6 h-6 text-slate-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
                <span id="cartBadge" class="absolute -top-2 -right-2 bg-teal-500 text-white text-xs font-bold px-2 py-0.5 rounded-full shadow-lg border border-teal-400 hidden">0</span>
            </button>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container mx-auto px-4 py-8 sm:py-12">
        
        <!-- Hero Section -->
        <div class="text-center max-w-3xl mx-auto mb-16 animate-slide-up">
            <h1 class="text-4xl sm:text-5xl font-extrabold text-white mb-4 leading-tight">
                Source Premium Wood <br>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-blue-400">Directly from Local Mills</span>
            </h1>
            <p class="text-slate-400 text-lg">Connect with top suppliers for raw timber, laminates, and furniture-grade wood. Activate Dealer Mode for exclusive wholesale pricing.</p>
        </div>

        <!-- Filters & Sort (Decorative) -->
        <div class="flex flex-wrap justify-between items-center mb-8 gap-4 glass-panel p-4 rounded-2xl">
            <div class="flex gap-2 overflow-x-auto pb-2 sm:pb-0 w-full sm:w-auto">
                <button class="px-4 py-2 rounded-lg bg-teal-500/20 text-teal-300 border border-teal-500/30 text-sm font-medium whitespace-nowrap">All Woods</button>
                <button class="px-4 py-2 rounded-lg bg-slate-800/50 text-slate-300 hover:bg-slate-700/50 border border-slate-700/50 text-sm font-medium whitespace-nowrap transition">Hardwood</button>
                <button class="px-4 py-2 rounded-lg bg-slate-800/50 text-slate-300 hover:bg-slate-700/50 border border-slate-700/50 text-sm font-medium whitespace-nowrap transition">Plywood</button>
                <button class="px-4 py-2 rounded-lg bg-slate-800/50 text-slate-300 hover:bg-slate-700/50 border border-slate-700/50 text-sm font-medium whitespace-nowrap transition">Veneers</button>
            </div>
            <div class="text-sm text-slate-400 flex items-center gap-2">
                <span>Sort by:</span>
                <select class="bg-slate-800 border border-slate-600 text-white rounded-lg px-3 py-1.5 focus:outline-none focus:border-teal-500 cursor-pointer">
                    <option>Recommended</option>
                    <option>Price: Low to High</option>
                    <option>Price: High to Low</option>
                </select>
            </div>
        </div>

        <!-- Product Grid -->
        <div id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            <!-- Products injected by JS -->
        </div>
    </main>

    <!-- Cart Sidebar Overlay -->
    <div id="cartOverlay" class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-50 hidden opacity-0 transition-opacity duration-300"></div>
    
    <!-- Cart Sidebar -->
    <div id="cartSidebar" class="fixed top-0 right-0 h-full w-full sm:w-[450px] glass-panel border-l border-slate-600/50 shadow-2xl z-50 transform translate-x-full transition-transform duration-300 flex flex-col">
        
        <!-- Cart Header -->
        <div class="px-6 py-5 border-b border-slate-700/50 flex justify-between items-center bg-slate-800/40">
            <h2 class="text-2xl font-bold text-white flex items-center gap-2">
                <svg class="w-6 h-6 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                Your Order
            </h2>
            <button id="closeCartBtn" class="p-2 rounded-full hover:bg-slate-700/50 text-slate-400 hover:text-white transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <!-- Cart Items -->
        <div id="cartItems" class="flex-1 overflow-y-auto p-6 space-y-4">
            <!-- Empty State -->
            <div class="h-full flex flex-col items-center justify-center text-slate-500 space-y-4">
                <svg class="w-16 h-16 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                <p>Your cart is empty.</p>
            </div>
        </div>

        <!-- Cart Footer -->
        <div class="border-t border-slate-700/50 bg-slate-900/60 p-6 flex flex-col gap-4">
            
            <!-- Delivery Option -->
            <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-700/50 bg-slate-800/40 cursor-pointer hover:border-teal-500/50 transition-colors">
                <input type="checkbox" id="deliveryToggle" class="w-5 h-5 rounded border-slate-600 text-teal-500 focus:ring-teal-500 bg-slate-700 cursor-pointer">
                <div class="flex-1">
                    <p class="text-sm font-semibold text-white">Home/Site Delivery</p>
                    <p class="text-xs text-slate-400">Within 50 kms (+ <span id="deliveryFeeDisplay">₹1,500</span>)</p>
                </div>
                <svg class="w-6 h-6 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
            </label>

            <!-- Totals -->
            <div class="space-y-2 text-sm text-slate-300">
                <div class="flex justify-between">
                    <span>Subtotal</span>
                    <span id="cartSubtotal" class="font-medium text-white">₹0</span>
                </div>
                <div id="dealerDiscountRow" class="flex justify-between text-teal-400 hidden">
                    <span>Dealer Savings</span>
                    <span id="cartSavings">-₹0</span>
                </div>
                <div id="deliveryFeeRow" class="flex justify-between hidden text-blue-300">
                    <span>Delivery Fee</span>
                    <span id="cartDeliveryFee">+₹1,500</span>
                </div>
            </div>
            
            <div class="border-t border-slate-700/50 pt-4 flex justify-between items-center mb-2">
                <span class="text-lg font-bold text-white">Total</span>
                <span id="cartTotal" class="text-2xl font-extrabold text-teal-400">₹0</span>
            </div>

            <button id="checkoutBtn" class="w-full py-4 rounded-xl bg-gradient-to-r from-teal-500 to-teal-600 hover:from-teal-400 hover:to-teal-500 text-white font-bold text-lg shadow-[0_0_20px_rgba(20,184,166,0.3)] transition-all hover:shadow-[0_0_25px_rgba(20,184,166,0.5)] transform hover:-translate-y-0.5 active:translate-y-0 disabled:opacity-50 disabled:cursor-not-allowed">
                Secure Checkout
            </button>
        </div>
    </div>

    <!-- Custom Modal for Checkout / Messages -->
    <div id="customModal" class="fixed inset-0 bg-slate-900/90 backdrop-blur-md z-[60] flex items-center justify-center hidden opacity-0 transition-opacity duration-300 p-4">
        <div class="glass-panel p-8 rounded-2xl max-w-md w-full text-center border-teal-500/30 transform scale-95 transition-transform duration-300 shadow-2xl" id="modalContent">
            <div class="w-20 h-20 bg-teal-500/20 rounded-full flex items-center justify-center mx-auto mb-6">
                <svg class="w-10 h-10 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-2" id="modalTitle">Order Confirmed!</h3>
            <p class="text-slate-300 mb-8" id="modalBody">Your order has been successfully placed. Our team will contact you shortly to confirm logistics.</p>
            <button id="closeModalBtn" class="w-full py-3 bg-slate-700 hover:bg-slate-600 text-white rounded-xl font-semibold transition-colors">Return to Marketplace</button>
        </div>
    </div>

    <!-- Toast Notifications Container -->
    <div id="toastContainer" class="fixed bottom-6 right-6 z-50 flex flex-col gap-3 pointer-events-none"></div>

    <script>
        // --- State Management ---
        const state = {
            isDealerMode: false,
            deliveryEnabled: false,
            deliveryFee: 1500,
            cart: [], // Array of { id, quantity }
            products: [
                {
                    id: 'p1',
                    name: 'Premium Teak Wood Logs',
                    desc: 'High-grade, durable teak perfect for outdoor furniture and decking. Ethically sourced.',
                    price: 20000,
                    dealerPrice: 15500,
                    unit: 'per cu ft',
                    image: 'https://placehold.co/600x400/1e293b/14b8a6?text=Teak+Wood',
                    category: 'Hardwood'
                },
                {
                    id: 'p2',
                    name: 'Oak Planks (Kiln Dried)',
                    desc: 'Smooth, ready-to-work oak planks. Ideal for cabinetry and interior flooring.',
                    price: 9500,
                    dealerPrice: 7000,
                    unit: 'per board ft',
                    image: 'https://placehold.co/600x400/1e293b/14b8a6?text=Oak+Planks',
                    category: 'Hardwood'
                },
                {
                    id: 'p3',
                    name: 'Mahogany Veneer Sheets',
                    desc: 'Rich, reddish-brown veneer sheets for high-end finishing and architectural paneling.',
                    price: 3600,
                    dealerPrice: 2500,
                    unit: 'per sheet',
                    image: 'https://placehold.co/600x400/1e293b/14b8a6?text=Mahogany+Veneer',
                    category: 'Veneers'
                },
                {
                    id: 'p4',
                    name: 'Birch Plywood 18mm',
                    desc: 'Multi-ply birch plywood. Excellent strength and void-free core. Standard 4x8 sheet.',
                    price: 6800,
                    dealerPrice: 5200,
                    unit: 'per sheet',
                    image: 'https://placehold.co/600x400/1e293b/14b8a6?text=Birch+Plywood',
                    category: 'Plywood'
                },
                {
                    id: 'p5',
                    name: 'Walnut Live Edge Slab',
                    desc: 'Unique, beautiful walnut slab for dining tables or bar tops. Bark partially intact.',
                    price: 36000,
                    dealerPrice: 28000,
                    unit: 'per slab',
                    image: 'https://placehold.co/600x400/1e293b/14b8a6?text=Walnut+Slab',
                    category: 'Hardwood'
                },
                {
                    id: 'p6',
                    name: 'Cherry Wood Blocks',
                    desc: 'Small blocks suitable for turning, carving, and small craft projects.',
                    price: 2800,
                    dealerPrice: 1750,
                    unit: 'per pack',
                    image: 'https://placehold.co/600x400/1e293b/14b8a6?text=Cherry+Blocks',
                    category: 'Hardwood'
                },
                {
                    id: 'p7',
                    name: 'MDF Boards 12mm',
                    desc: 'Medium-density fibreboard. Smooth surface, easy to paint and route.',
                    price: 2000,
                    dealerPrice: 1450,
                    unit: 'per sheet',
                    image: 'https://placehold.co/600x400/1e293b/14b8a6?text=MDF+Boards',
                    category: 'Plywood'
                },
                {
                    id: 'p8',
                    name: 'Ash Wood Dimensional Lumber',
                    desc: 'Strong and flexible. Great for tool handles and curved furniture pieces.',
                    price: 7600,
                    dealerPrice: 5600,
                    unit: 'per board ft',
                    image: 'https://placehold.co/600x400/1e293b/14b8a6?text=Ash+Lumber',
                    category: 'Hardwood'
                }
            ]
        };

        // --- DOM Elements ---
        const productGrid = document.getElementById('productGrid');
        const dealerToggle = document.getElementById('dealerToggle');
        const toggleBg = document.getElementById('toggleBg');
        const toggleDot = document.getElementById('toggleDot');
        const dealerStatusText = document.getElementById('dealerStatusText');
        
        const cartBtn = document.getElementById('cartBtn');
        const cartBadge = document.getElementById('cartBadge');
        const cartSidebar = document.getElementById('cartSidebar');
        const cartOverlay = document.getElementById('cartOverlay');
        const closeCartBtn = document.getElementById('closeCartBtn');
        const cartItemsContainer = document.getElementById('cartItems');
        const cartSubtotalEl = document.getElementById('cartSubtotal');
        const cartSavingsEl = document.getElementById('cartSavings');
        const cartDeliveryFeeEl = document.getElementById('cartDeliveryFee');
        const cartTotalEl = document.getElementById('cartTotal');
        const deliveryToggle = document.getElementById('deliveryToggle');
        const checkoutBtn = document.getElementById('checkoutBtn');
        
        const dealerDiscountRow = document.getElementById('dealerDiscountRow');
        const deliveryFeeRow = document.getElementById('deliveryFeeRow');

        const customModal = document.getElementById('customModal');
        const modalContent = document.getElementById('modalContent');
        const closeModalBtn = document.getElementById('closeModalBtn');
        const toastContainer = document.getElementById('toastContainer');

        // --- Utilities ---
        const formatMoney = (amount) => {
            return new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(amount);
        };

        const showToast = (message) => {
            const toast = document.createElement('div');
            toast.className = 'glass-panel px-4 py-3 rounded-lg shadow-lg text-white text-sm font-medium border-teal-500/30 flex items-center gap-2 animate-slide-up pointer-events-auto';
            toast.innerHTML = `
                <svg class="w-5 h-5 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                ${message}
            `;
            toastContainer.appendChild(toast);
            
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(10px)';
                toast.style.transition = 'all 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        };

        const showModal = (title, body) => {
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalBody').innerText = body;
            customModal.classList.remove('hidden');
            // Small delay to allow display block to apply before animating opacity
            setTimeout(() => {
                customModal.classList.remove('opacity-0');
                modalContent.classList.remove('scale-95');
            }, 10);
        };

        const hideModal = () => {
            customModal.classList.add('opacity-0');
            modalContent.classList.add('scale-95');
            setTimeout(() => {
                customModal.classList.add('hidden');
            }, 300);
        };

        // --- Render Functions ---

        const renderProducts = () => {
            productGrid.innerHTML = '';
            
            state.products.forEach((product, index) => {
                const isDealer = state.isDealerMode;
                const displayPrice = isDealer ? product.dealerPrice : product.price;
                const savings = product.price - product.dealerPrice;
                
                const dealerBadgeHtml = isDealer 
                    ? `<div class="absolute top-4 left-4 bg-teal-500 text-slate-900 text-xs font-bold px-3 py-1 rounded-full shadow-lg z-10">Wholesale Rate</div>` 
                    : '';

                const priceHtml = isDealer 
                    ? `<div class="flex flex-col">
                           <span class="text-sm text-slate-500 line-through">Retail: ${formatMoney(product.price)}</span>
                           <span class="text-2xl font-bold text-teal-400">${formatMoney(displayPrice)} <span class="text-sm font-normal text-slate-400">${product.unit}</span></span>
                       </div>`
                    : `<span class="text-2xl font-bold text-white">${formatMoney(displayPrice)} <span class="text-sm font-normal text-slate-400">${product.unit}</span></span>`;

                const cardHtml = `
                    <div class="glass-card rounded-2xl overflow-hidden flex flex-col h-full animate-slide-up" style="animation-delay: ${index * 0.05}s">
                        <div class="relative h-48 overflow-hidden group">
                            ${dealerBadgeHtml}
                            <img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110 opacity-80 group-hover:opacity-100 mix-blend-luminosity hover:mix-blend-normal">
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent to-transparent opacity-80"></div>
                        </div>
                        <div class="p-5 flex flex-col flex-1">
                            <span class="text-xs font-semibold text-teal-400 uppercase tracking-wider mb-1">${product.category}</span>
                            <h3 class="text-xl font-bold text-white mb-2 leading-tight">${product.name}</h3>
                            <p class="text-sm text-slate-400 mb-6 flex-1">${product.desc}</p>
                            
                            <div class="flex items-end justify-between mt-auto pt-4 border-t border-slate-700/50">
                                ${priceHtml}
                                <button onclick="addToCart('${product.id}')" class="bg-slate-700 hover:bg-teal-500 hover:text-slate-900 text-white p-3 rounded-xl transition-all shadow-md group">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
                productGrid.insertAdjacentHTML('beforeend', cardHtml);
            });
        };

        const renderCart = () => {
            cartItemsContainer.innerHTML = '';
            
            if (state.cart.length === 0) {
                cartItemsContainer.innerHTML = `
                    <div class="h-full flex flex-col items-center justify-center text-slate-500 space-y-4">
                        <svg class="w-16 h-16 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                        <p>Your cart is empty.</p>
                    </div>
                `;
                cartBadge.classList.add('hidden');
                checkoutBtn.disabled = true;
            } else {
                let totalItems = 0;
                
                state.cart.forEach(item => {
                    const product = state.products.find(p => p.id === item.id);
                    if (!product) return;
                    
                    totalItems += item.quantity;
                    const price = state.isDealerMode ? product.dealerPrice : product.price;
                    
                    const cartItemHtml = `
                        <div class="flex gap-4 p-3 bg-slate-800/40 rounded-xl border border-slate-700/50 relative group">
                            <div class="w-20 h-20 rounded-lg overflow-hidden flex-shrink-0 bg-slate-700">
                                <img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover opacity-80">
                            </div>
                            <div class="flex-1 flex flex-col justify-between py-1">
                                <div>
                                    <h4 class="text-sm font-semibold text-white line-clamp-1">${product.name}</h4>
                                    <p class="text-xs text-slate-400 mt-0.5">${formatMoney(price)} ${product.unit}</p>
                                </div>
                                <div class="flex items-center gap-3">
                                    <div class="flex items-center bg-slate-900/50 rounded-lg border border-slate-600/50">
                                        <button onclick="updateQuantity('${item.id}', -1)" class="w-7 h-7 flex items-center justify-center text-slate-400 hover:text-white transition-colors">-</button>
                                        <span class="w-8 text-center text-sm font-medium text-white">${item.quantity}</span>
                                        <button onclick="updateQuantity('${item.id}', 1)" class="w-7 h-7 flex items-center justify-center text-slate-400 hover:text-white transition-colors">+</button>
                                    </div>
                                    <span class="text-sm font-bold text-teal-400 ml-auto">${formatMoney(price * item.quantity)}</span>
                                </div>
                            </div>
                            <button onclick="removeFromCart('${item.id}')" class="absolute -top-2 -right-2 bg-slate-700 hover:bg-red-500 text-white p-1 rounded-full opacity-0 group-hover:opacity-100 transition-all shadow-md">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            </button>
                        </div>
                    `;
                    cartItemsContainer.insertAdjacentHTML('beforeend', cartItemHtml);
                });

                cartBadge.innerText = totalItems;
                cartBadge.classList.remove('hidden');
                checkoutBtn.disabled = false;
            }

            calculateTotals();
        };

        const calculateTotals = () => {
            let subtotal = 0;
            let totalRetailValue = 0;

            state.cart.forEach(item => {
                const product = state.products.find(p => p.id === item.id);
                if (!product) return;

                const priceToUse = state.isDealerMode ? product.dealerPrice : product.price;
                subtotal += priceToUse * item.quantity;
                totalRetailValue += product.price * item.quantity;
            });

            // Update DOM
            cartSubtotalEl.innerText = formatMoney(subtotal);

            // Handle Savings Display
            if (state.isDealerMode && subtotal > 0) {
                const savings = totalRetailValue - subtotal;
                cartSavingsEl.innerText = `-${formatMoney(savings)}`;
                dealerDiscountRow.classList.remove('hidden');
            } else {
                dealerDiscountRow.classList.add('hidden');
            }

            // Handle Delivery
            let total = subtotal;
            if (state.deliveryEnabled && subtotal > 0) {
                total += state.deliveryFee;
                deliveryFeeRow.classList.remove('hidden');
            } else {
                deliveryFeeRow.classList.add('hidden');
            }

            cartTotalEl.innerText = formatMoney(total);
        };


        // --- Actions ---

        window.addToCart = (productId) => {
            const existingItem = state.cart.find(item => item.id === productId);
            if (existingItem) {
                existingItem.quantity += 1;
            } else {
                state.cart.push({ id: productId, quantity: 1 });
            }
            
            const product = state.products.find(p => p.id === productId);
            showToast(`${product.name} added to cart`);
            
            renderCart();
            // Jiggle cart button for feedback
            cartBtn.classList.add('scale-110', 'text-teal-400');
            setTimeout(() => cartBtn.classList.remove('scale-110', 'text-teal-400'), 200);
        };

        window.updateQuantity = (productId, delta) => {
            const item = state.cart.find(i => i.id === productId);
            if (item) {
                item.quantity += delta;
                if (item.quantity <= 0) {
                    state.cart = state.cart.filter(i => i.id !== productId);
                }
                renderCart();
            }
        };

        window.removeFromCart = (productId) => {
            state.cart = state.cart.filter(i => i.id !== productId);
            renderCart();
        };

        const toggleCart = (show) => {
            if (show) {
                cartOverlay.classList.remove('hidden');
                // slight delay for transition
                setTimeout(() => {
                    cartOverlay.classList.remove('opacity-0');
                    cartSidebar.classList.remove('translate-x-full');
                }, 10);
                document.body.classList.add('cart-open');
            } else {
                cartSidebar.classList.add('translate-x-full');
                cartOverlay.classList.add('opacity-0');
                setTimeout(() => {
                    cartOverlay.classList.add('hidden');
                    document.body.classList.remove('cart-open');
                }, 300);
            }
        };

        // --- Event Listeners ---

        // Dealer Toggle Logic
        dealerToggle.addEventListener('change', (e) => {
            state.isDealerMode = e.target.checked;
            
            if (state.isDealerMode) {
                // UI changes for Dealer Mode ON
                toggleBg.classList.replace('bg-slate-700', 'bg-teal-500');
                toggleBg.classList.replace('border-slate-600', 'border-teal-400');
                toggleDot.classList.add('translate-x-5');
                dealerStatusText.innerText = "B2B Wholesale Active";
                dealerStatusText.classList.replace('text-slate-500', 'text-teal-400');
                showToast("Dealer pricing activated");
            } else {
                // UI changes for Dealer Mode OFF
                toggleBg.classList.replace('bg-teal-500', 'bg-slate-700');
                toggleBg.classList.replace('border-teal-400', 'border-slate-600');
                toggleDot.classList.remove('translate-x-5');
                dealerStatusText.innerText = "B2C Retail Mode";
                dealerStatusText.classList.replace('text-teal-400', 'text-slate-500');
                showToast("Reverted to retail pricing");
            }

            // Re-render everything to update prices
            renderProducts();
            renderCart();
        });

        // Delivery Toggle
        deliveryToggle.addEventListener('change', (e) => {
            state.deliveryEnabled = e.target.checked;
            calculateTotals();
        });

        // Cart UI Interactions
        cartBtn.addEventListener('click', () => toggleCart(true));
        closeCartBtn.addEventListener('click', () => toggleCart(false));
        cartOverlay.addEventListener('click', () => toggleCart(false));

        // Checkout Action
        checkoutBtn.addEventListener('click', () => {
            if (state.cart.length === 0) return;
            
            toggleCart(false);
            
            // Clear cart
            state.cart = [];
            renderCart();
            
            // Show Success Modal
            setTimeout(() => {
                showModal(
                    "Order Successfully Placed!", 
                    "Thank you for choosing TimberLink. Your invoice and delivery details have been generated. Our dispatch team will contact you shortly."
                );
            }, 300);
        });

        // Modal close
        closeModalBtn.addEventListener('click', hideModal);

        // --- Initialization ---
        document.addEventListener('DOMContentLoaded', () => {
            renderProducts();
            renderCart();
        });

    </script>
</body>
</html>
