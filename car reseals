    /* Sound Synthesizer via Tone.js */
    let audioReady = false;
    async function playLuxuryChime(type = 'bid') {
      try {
        if (!audioReady) {
          await Tone.start();
          audioReady = true;
        }
        const synth = new Tone.PolySynth(Tone.Synth).toDestination();
        synth.volume.value = -8;
        
        if (type === 'bid') {
          // Dignified auction bell chord
          synth.triggerAttackRelease(["C5", "G5", "C6"], "16n");
        } else if (type === 'gavel') {
          synth.triggerAttackRelease(["D4", "A4"], "8n");
        } else if (type === 'success') {
          synth.triggerAttackRelease(["E5", "G#5", "B5", "E6"], "8n");
        }
      } catch (err) {
        // Fallback gracefully without throwing
      }
    }

