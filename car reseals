<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AURELIA // Fine Vintage Automobiles & Auctions</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <!-- Tone.js for elegant audio feedback -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            onyx: '#08090C',
            obsidian: '#0E1015',
            surface: '#151821',
            surfaceLight: '#1E2330',
            gold: {
              300: '#F9E2AF',
              400: '#E7C885',
              500: '#D4AF37',
              600: '#B8860B',
              700: '#996515',
            },
            crimson: '#8B1822',
            emeraldBadge: '#10B981'
          },
          fontFamily: {
            serif: ['Cinzel', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <style>
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #08090C;
    }
    ::-webkit-scrollbar-thumb {
      background: #2a3142;
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #D4AF37;
    }

    /* Luxury Shimmer Effect */
    .gold-gradient-text {
      background: linear-gradient(135deg, #FFF1CA 0%, #D4AF37 50%, #AA771C 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .gold-border-gradient {
      border-image: linear-gradient(to right, #D4AF37, #5c4516, #D4AF37) 1;
    }
    .glass-panel {
      background: rgba(21, 24, 33, 0.78);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(212, 175, 55, 0.18);
    }
    .glass-panel-elevated {
      background: rgba(28, 33, 46, 0.88);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(212, 175, 55, 0.35);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
    }

    /* Keyframe Animations */
    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 15px rgba(212, 175, 55, 0.2); }
      50% { box-shadow: 0 0 30px rgba(212, 175, 55, 0.55); }
    }
    .live-glow {
      animation: pulseGlow 2.5s infinite;
    }
    @keyframes bidFlash {
      0% { background-color: rgba(212, 175, 55, 0.4); transform: scale(1.02); }
      100% { background-color: transparent; transform: scale(1); }
    }
    .bid-flash {
      animation: bidFlash 0.7s ease-out;
    }
  </style>
</head>
<body class="bg-onyx text-slate-200 font-sans antialiased selection:bg-gold-500 selection:text-black min-h-screen flex flex-col">

  <!-- TOP STATUS BANNER (VIP NOTIFICATION & CURRENT EXCHANGE) -->
  <div class="bg-gradient-to-r from-obsidian via-surface to-obsidian border-b border-gold-500/20 text-xs py-2 px-4">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3 text-slate-400">
      <div class="flex items-center space-x-3">
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wider uppercase bg-red-950/80 text-red-400 border border-red-500/30">
          <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-red-500 animate-ping"></span> Live Session
        </span>
        <span class="hidden sm:inline text-slate-300">Monaco Autumn Grand Marquee Auction // Monterey Hall VII</span>
      </div>
      <div class="flex items-center space-x-4 text-xs">
        <span class="hidden md:inline"><i class="fa-solid fa-shield-halved text-gold-500 mr-1.5"></i> Escrow Secured by Sotheby's Financial Services</span>
        <div id="authStatusPill" class="flex items-center gap-1.5 text-gold-400 cursor-pointer hover:underline" onclick="openVipModal()">
          <i class="fa-solid fa-crown text-xs"></i>
          <span id="navTierName">Guest Explorer (Unverified)</span>
        </div>
      </div>
    </div>
  </div>

  <!-- NAVIGATION -->
  <header class="sticky top-0 z-40 bg-onyx/90 backdrop-blur-md border-b border-white/5 transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      <!-- Brand Logo -->
      <a href="#" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-lg border border-gold-500/60 bg-surface flex items-center justify-center shadow-lg shadow-gold-500/10 group-hover:border-gold-400 transition-colors">
          <i class="fa-solid fa-award text-gold-500 text-lg group-hover:scale-110 transition-transform"></i>
        </div>
        <div>
          <span class="font-serif text-xl sm:text-2xl font-bold tracking-widest text-white block">AURELIA</span>
          <span class="text-[9px] uppercase tracking-[0.3em] text-gold-400 block -mt-1 font-semibold">Fine Collector Auctions</span>
        </div>
      </a>

      <!-- Desktop Nav links -->
      <nav class="hidden md:flex items-center space-x-8 text-sm font-medium">
        <a href="#featured-live" class="text-white hover:text-gold-400 transition-colors tracking-wide flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-red-500"></span> Live Lot
        </a>
        <a href="#catalogue" class="text-slate-300 hover:text-gold-400 transition-colors tracking-wide">The Vault Collection</a>
        <a href="#calculator" class="text-slate-300 hover:text-gold-400 transition-colors tracking-wide">Valuation Engine</a>
        <a href="#provenance" class="text-slate-300 hover:text-gold-400 transition-colors tracking-wide">Provenance & Audit</a>
      </nav>

      <!-- Action Group -->
      <div class="flex items-center space-x-3">
        <!-- Watchlist trigger -->
        <button onclick="toggleWatchlistModal()" class="relative p-2.5 rounded-lg border border-white/10 hover:border-gold-500/50 bg-surface/80 text-slate-300 hover:text-gold-400 transition-all text-sm">
          <i class="fa-regular fa-bookmark"></i>
          <span id="watchlistCountBadge" class="absolute -top-1 -right-1 bg-gold-500 text-black text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center">0</span>
        </button>

        <!-- VIP Membership Action Button -->
        <button id="vipMembershipBtn" onclick="openVipModal()" class="relative group overflow-hidden px-4 sm:px-5 py-2.5 rounded-lg text-xs sm:text-sm font-semibold tracking-wide border border-gold-500/60 bg-gradient-to-r from-gold-600 via-gold-500 to-gold-400 text-black shadow-lg shadow-gold-500/20 hover:shadow-gold-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center gap-2">
          <i class="fa-solid fa-id-card-clip text-black"></i>
          <span id="vipBtnText">Register as VIP Bidder</span>
        </button>
      </div>
    </div>
  </header>

  <main class="flex-grow">
    <!-- HERO SECTION -->
    <section class="relative overflow-hidden border-b border-gold-500/10">
      <!-- Background Ambient Glow -->
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_20%,rgba(212,175,55,0.12),transparent_70%)] pointer-events-none"></div>
      <div class="absolute -top-24 -left-24 w-96 h-96 bg-gold-600/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 relative z-10">
        <div class="grid lg:grid-cols-12 gap-12 items-center">
          
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center gap-2.5 px-3 py-1 rounded-full border border-gold-500/30 bg-gold-500/5 text-gold-400 text-xs font-semibold uppercase tracking-wider">
              <i class="fa-solid fa-gem text-[10px]"></i> Curated Historical Masterpieces
            </div>
            
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-black tracking-tight text-white leading-tight">
              Where Automotive Legend Meets <span class="gold-gradient-text">Private Prestige</span>
            </h1>
            
            <p class="text-slate-400 text-base sm:text-lg max-w-xl font-light leading-relaxed">
              Step into the world's most discreet collector salon. Certified chassis records, authentic race histories, and high-stakes real-time private floor bidding for vetted international connoisseurs.
            </p>

            <div class="pt-4 flex flex-wrap gap-4 items-center">
              <a href="#featured-live" class="px-7 py-3.5 rounded-lg bg-gold-500 hover:bg-gold-400 text-black font-semibold text-sm tracking-wide transition-all duration-200 shadow-xl shadow-gold-500/25 flex items-center gap-2">
                <span>Enter Live Auction Floor</span>
                <i class="fa-solid fa-arrow-right text-xs"></i>
              </a>
              <button onclick="openVipModal()" class="px-6 py-3.5 rounded-lg border border-gold-500/40 hover:border-gold-400 bg-surface hover:bg-surfaceLight text-slate-200 font-semibold text-sm tracking-wide transition-all flex items-center gap-2">
                <i class="fa-solid fa-fingerprint text-gold-500"></i>
                <span>Bidder Identity Verification</span>
              </button>
            </div>

            <!-- Trust Badges -->
            <div class="pt-8 grid grid-cols-3 gap-6 border-t border-white/10 max-w-lg">
              <div>
                <p class="text-2xl font-serif font-bold text-white tracking-tight">$184M+</p>
                <p class="text-xs text-slate-400 uppercase tracking-wider mt-0.5">Historical Volume</p>
              </div>
              <div>
                <p class="text-2xl font-serif font-bold text-gold-400 tracking-tight">100%</p>
                <p class="text-xs text-slate-400 uppercase tracking-wider mt-0.5">Verified Chassis</p>
              </div>
              <div>
                <p class="text-2xl font-serif font-bold text-white tracking-tight">Tier-1</p>
                <p class="text-xs text-slate-400 uppercase tracking-wider mt-0.5">VIP Escrow Hub</p>
              </div>
            </div>
          </div>

          <!-- Hero Spotlight Card -->
          <div class="lg:col-span-5">
            <div class="glass-panel-elevated rounded-2xl p-6 relative overflow-hidden group">
              <div class="absolute top-4 right-4 z-20">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-red-600/90 text-white shadow-lg backdrop-blur-md">
                  <span class="w-2 h-2 rounded-full bg-white mr-2 animate-ping"></span> HIGHEST LOT TODAY
                </span>
              </div>
              
              <!-- Car Visual Hero Image -->
              <div class="relative h-64 sm:h-72 w-full rounded-xl overflow-hidden bg-onyx mb-5">
                <img id="heroImagePreview" 
                     src="https://images.unsplash.com/photo-1583121274602-3e2820c69888?auto=format&fit=crop&w=1200&q=80" 
                     alt="1961 Ferrari 250 GT California Spyder" 
                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent"></div>
                <div class="absolute bottom-3 left-3 right-3 flex justify-between items-end">
                  <div>
                    <span class="text-[11px] font-bold uppercase tracking-widest text-gold-400">LOT #42</span>
                    <h3 class="text-lg font-serif font-bold text-white">1961 Ferrari 250 GT California SWB</h3>
                  </div>
                  <span class="text-xs px-2.5 py-1 bg-black/70 border border-gold-500/40 rounded text-gold-400 font-mono">VIN #2871GT</span>
                </div>
              </div>

              <!-- Quick Stats Grid -->
              <div class="grid grid-cols-3 gap-2.5 mb-5 text-center">
                <div class="p-2.5 rounded-lg bg-surface/90 border border-white/5">
                  <span class="block text-[10px] text-slate-400 uppercase tracking-wider">Engine</span>
                  <span class="text-xs font-semibold text-white">3.0L Colombo V12</span>
                </div>
                <div class="p-2.5 rounded-lg bg-surface/90 border border-white/5">
                  <span class="block text-[10px] text-slate-400 uppercase tracking-wider">Condition</span>
                  <span class="text-xs font-semibold text-emerald-400">99.4 Concours</span>
                </div>
                <div class="p-2.5 rounded-lg bg-surface/90 border border-white/5">
                  <span class="block text-[10px] text-slate-400 uppercase tracking-wider">Est. Value</span>
                  <span class="text-xs font-semibold text-gold-400">$16.5M - $18M</span>
                </div>
              </div>

              <div class="flex items-center justify-between pt-2 border-t border-white/10">
                <div>
                  <span class="text-[11px] text-slate-400 block uppercase">Current High Standing</span>
                  <span class="text-2xl font-serif font-black text-white" id="heroLiveBid">$15,400,000</span>
                </div>
                <button onclick="scrollToLiveLot(1)" class="px-5 py-2.5 rounded-lg bg-gold-500 hover:bg-gold-400 text-black font-bold text-xs uppercase tracking-wider transition-all shadow-md">
                  Bid On This Lot
                </button>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- LIVE AUCTION SALON / REAL-TIME BIDDING CONSOLE -->
    <section id="featured-live" class="py-16 bg-surface/40 border-b border-gold-500/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-4 border-b border-white/10 gap-4">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="relative flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-red-500"></span>
              </span>
              <span class="text-xs font-bold uppercase tracking-widest text-red-500">Official Live Bidding Floor</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-white">Active Marquee Session</h2>
            <p class="text-sm text-slate-400">Bids made here are legally binding under international private auction statutes.</p>
          </div>

          <!-- Switch Live Active Lot Dropdown -->
          <div class="flex items-center gap-3">
            <label for="lotSelector" class="text-xs text-slate-400 font-medium whitespace-nowrap">Switch Lot Floor:</label>
            <select id="lotSelector" onchange="switchLiveLot(this.value)" class="bg-surface border border-gold-500/30 text-gold-400 text-sm rounded-lg px-3 py-2 focus:outline-none focus:border-gold-500">
              <!-- populated in JS -->
            </select>
          </div>
        </div>

        <!-- The Bidding Theater Board -->
        <div class="grid lg:grid-cols-12 gap-8 items-start">
          
          <!-- Car Visual & Tabbed Intelligence (8 Cols) -->
          <div class="lg:col-span-8 space-y-6">
            <div class="glass-panel rounded-2xl overflow-hidden p-1 sm:p-2">
              <!-- Main Gallery Frame -->
              <div class="relative h-80 sm:h-[420px] rounded-xl overflow-hidden bg-black">
                <img id="liveCarMainImage" src="" alt="Live car" class="w-full h-full object-cover transition-opacity duration-300">
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20 pointer-events-none"></div>

                <!-- Overlaid Badges -->
                <div class="absolute top-4 left-4 flex flex-wrap gap-2">
                  <span id="liveCarLotBadge" class="px-3 py-1 rounded bg-black/80 border border-gold-500/40 text-gold-400 text-xs font-mono font-bold">LOT #--</span>
                  <span id="liveCarReserveBadge" class="px-3 py-1 rounded bg-emerald-950/90 border border-emerald-500/50 text-emerald-400 text-xs font-bold flex items-center gap-1.5">
                    <i class="fa-solid fa-circle-check text-xs"></i> Reserve Met
                  </span>
                  <span class="px-3 py-1 rounded bg-surface/80 border border-white/10 text-slate-300 text-xs">Certified Matching Numbers</span>
                </div>

                <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between">
                  <div>
                    <h3 id="liveCarTitle" class="text-xl sm:text-2xl lg:text-3xl font-serif font-black text-white">Car Name</h3>
                    <p id="liveCarSubtitle" class="text-xs sm:text-sm text-gold-400 font-medium">Coachwork by Scaglietti • Chassis 2871GT</p>
                  </div>
                  <button onclick="toggleWatchlistCurrentLot()" id="liveBookmarkBtn" class="p-3 rounded-xl bg-black/60 border border-white/20 text-white hover:text-gold-400 transition-colors">
                    <i class="fa-regular fa-bookmark"></i>
                  </button>
                </div>
              </div>

              <!-- Interactive Tabs Section -->
              <div class="p-4 sm:p-6">
                <!-- Tab Headers -->
                <div class="flex border-b border-white/10 space-x-6 text-sm font-semibold mb-6 overflow-x-auto pb-1">
                  <button onclick="switchTab('specs')" id="tabBtn-specs" class="tab-btn pb-2 border-b-2 border-gold-500 text-gold-400 transition-colors">Chassis Specs</button>
                  <button onclick="switchTab('provenance')" id="tabBtn-provenance" class="tab-btn pb-2 border-b-2 border-transparent text-slate-400 hover:text-white transition-colors">Provenance & Lineage</button>
                  <button onclick="switchTab('condition')" id="tabBtn-condition" class="tab-btn pb-2 border-b-2 border-transparent text-slate-400 hover:text-white transition-colors">Inspection & Audit</button>
                  <button onclick="switchTab('documents')" id="tabBtn-documents" class="tab-btn pb-2 border-b-2 border-transparent text-slate-400 hover:text-white transition-colors">Verified Docs (VIP)</button>
                </div>

                <!-- Tab 1: Specs -->
                <div id="tabContent-specs" class="tab-pane space-y-4">
                  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4" id="liveSpecsGrid">
                    <!-- Populated dynamically -->
                  </div>
                  <p id="liveCarDescription" class="text-sm text-slate-300 leading-relaxed pt-2"></p>
                </div>

                <!-- Tab 2: Provenance -->
                <div id="tabContent-provenance" class="tab-pane hidden space-y-3">
                  <h4 class="text-xs uppercase font-bold text-gold-400 tracking-wider">Documented Ownership Chain</h4>
                  <div id="liveProvenanceTimeline" class="space-y-3 border-l-2 border-gold-500/30 pl-4 ml-1">
                    <!-- Populated dynamically -->
                  </div>
                </div>

                <!-- Tab 3: Condition -->
                <div id="tabContent-condition" class="tab-pane hidden space-y-4">
                  <div class="flex flex-col sm:flex-row items-center justify-between p-4 rounded-xl bg-surface border border-gold-500/20 gap-4">
                    <div class="flex items-center gap-4">
                      <div class="w-14 h-14 rounded-full border-2 border-gold-500 flex items-center justify-center font-serif text-lg font-bold text-gold-400" id="conditionScoreBadge">
                        99.2
                      </div>
                      <div>
                        <h4 class="text-sm font-bold text-white">Concours d'Elegance Grade Certification</h4>
                        <p class="text-xs text-slate-400">Inspected by FIVA Master Evaluators on October 2026</p>
                      </div>
                    </div>
                    <span class="px-3 py-1 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs rounded-full">Factory Original Engine & Gearbox</span>
                  </div>
                  <div class="grid sm:grid-cols-3 gap-3 text-xs" id="conditionAspectsGrid">
                    <!-- Populated dynamically -->
                  </div>
                </div>

                <!-- Tab 4: Verified Documents (VIP) -->
                <div id="tabContent-documents" class="tab-pane hidden space-y-4">
                  <div class="p-4 rounded-xl bg-gradient-to-r from-surface to-surfaceLight border border-gold-500/30 flex flex-col sm:flex-row justify-between items-center gap-4">
                    <div>
                      <h4 class="text-sm font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-file-shield text-gold-400"></i> Dossier de Vente & Restoration Archival Records
                      </h4>
                      <p class="text-xs text-slate-400 mt-1">Includes high-resolution dynamometer charts, frame alignment laser scans & customs clearances.</p>
                    </div>
                    <button onclick="downloadConditionReport()" class="px-4 py-2 rounded-lg bg-gold-500 hover:bg-gold-400 text-black text-xs font-bold uppercase tracking-wider flex items-center gap-2 whitespace-nowrap">
                      <i class="fa-solid fa-download"></i> Access Dossier
                    </button>
                  </div>
                  <p class="text-[11px] text-slate-500 italic">* Full unredacted telemetry and previous title deeds are reserved exclusively for Verified Collector tier members.</p>
                </div>

              </div>
            </div>
          </div>

          <!-- Real-Time Bid Engine & Action Terminal (4 Cols) -->
          <div class="lg:col-span-4 space-y-5">
            
            <!-- Bid Cockpit Card -->
            <div class="glass-panel-elevated rounded-2xl p-6 relative overflow-hidden" id="liveBidPanel">
              <div class="flex items-center justify-between pb-3 border-b border-white/10 mb-4">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Time Remaining</span>
                <!-- Anti-sniping Dynamic Countdown -->
                <div class="flex items-center gap-1.5 font-mono text-base font-bold text-red-400" id="lotCountdownDisplay">
                  <i class="fa-regular fa-clock text-xs"></i>
                  <span id="timerMin">04</span>:<span id="timerSec">32</span>
                </div>
              </div>

              <!-- Current Valuation Highlight -->
              <div class="mb-5">
                <span class="text-[11px] text-slate-400 uppercase tracking-wider block font-medium">Current Highest Bid</span>
                <div class="flex items-baseline gap-2 mt-1">
                  <span id="currentBidPriceDisplay" class="text-3xl sm:text-4xl font-serif font-black text-gold-400 transition-all duration-300">
                    $15,400,000
                  </span>
                  <span class="text-xs text-slate-400 font-mono">USD</span>
                </div>
                <div class="flex items-center justify-between mt-2 text-xs">
                  <span class="text-slate-400">Reserve: <strong class="text-emerald-400" id="reserveText">MET</strong></span>
                  <span class="text-slate-400">Bids Placed: <strong class="text-white" id="totalBidsCount">27</strong></span>
                </div>
              </div>

              <!-- Quick Increment Fast-Action Buttons -->
              <div class="space-y-2.5 mb-6">
                <span class="text-[11px] font-semibold text-slate-300 block uppercase tracking-wider">Quick Increment:</span>
                <div class="grid grid-cols-3 gap-2">
                  <button onclick="placeQuickBid(10000)" class="py-2.5 px-2 rounded-lg bg-surfaceLight hover:bg-gold-500/20 border border-gold-500/30 text-gold-300 font-mono text-xs font-bold transition-all hover:border-gold-400">
                    +$10,000
                  </button>
                  <button onclick="placeQuickBid(25000)" class="py-2.5 px-2 rounded-lg bg-surfaceLight hover:bg-gold-500/20 border border-gold-500/30 text-gold-300 font-mono text-xs font-bold transition-all hover:border-gold-400">
                    +$25,000
                  </button>
                  <button onclick="placeQuickBid(50000)" class="py-2.5 px-2 rounded-lg bg-surfaceLight hover:bg-gold-500/20 border border-gold-500/30 text-gold-300 font-mono text-xs font-bold transition-all hover:border-gold-400">
                    +$50,000
                  </button>
                </div>

                <!-- Custom Bid Input -->
                <div class="pt-2">
                  <div class="relative">
