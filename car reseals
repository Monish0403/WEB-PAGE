        const secs = currentCar.timerSeconds % 60;

        document.getElementById('timerMin').textContent = String(mins).padStart(2, '0');
        document.getElementById('timerSec').textContent = String(secs).padStart(2, '0');

        // Visual alert when time is low
        const clockEl = document.getElementById('lotCountdownDisplay');
        if (currentCar.timerSeconds < 60) {
          clockEl.classList.add('animate-pulse');
        } else {
          clockEl.classList.remove('animate-pulse');
        }
      }, 1000);
    }

    /* Anti-sniping: add seconds when a bid comes late */
    function triggerAntiSnipingBuffer(car) {
      if (car.timerSeconds < 120) {
        car.timerSeconds += 60; // add 1 minute
        showToast("Anti-sniping protection activated: +60 seconds added to timer.", "warning");
      }
    }

    /* ==========================================================================
       5. BIDDING ACTIONS & SECURITY CHECKS (VIP GATEWAY)
       ========================================================================== */
    function requireVipAccess() {
      if (!userState.isVerified) {
        openVipModal();
        showToast("VIP Verification Required: Please upgrade to bid on live marquee lots.", "warning");
        return false;
      }
      return true;
    }

    function placeQuickBid(increment) {
      if (!requireVipAccess()) return;
      const car = VINTAGE_VAULT.find(c => c.id == activeLiveLotId);
      if (!car) return;

      const newBid = car.currentBid + increment;
      commitBid(car, newBid);
    }

    function placeCustomBid() {
      if (!requireVipAccess()) return;
      const car = VINTAGE_VAULT.find(c => c.id == activeLiveLotId);
      if (!car) return;

      const input = document.getElementById('customBidInput');
      const val = parseInt(input.value, 10);
      const minRequired = car.currentBid + 10000;

      if (isNaN(val) || val < minRequired) {
        showToast(`Bid must be at least ${formatCurrency(minRequired)}`, "error");
        return;
      }

      commitBid(car, val);
      input.value = '';
    }

    function executeTopFloorBid() {
      if (!requireVipAccess()) return;
      const car = VINTAGE_VAULT.find(c => c.id == activeLiveLotId);
      if (!car) return;

      const nextMin = car.currentBid + 10000;
      commitBid(car, nextMin);
    }

    function commitBid(car, newAmount) {
      car.currentBid = newAmount;
      car.bidsCount++;

      // User's private masked identity
      const bidderIdentifier = `${userState.name} (${userState.bidderPaddle || 'Paddle #889'})`;

      car.recentBids.unshift({
        bidder: bidderIdentifier,
        amount: newAmount,
        time: "Just now"
      });

      // Keep recent bids to max 8
      if (car.recentBids.length > 8) car.recentBids.pop();

      // Trigger Visual pulse & Audio
      playLuxuryChime('bid');
      triggerAntiSnipingBuffer(car);

      // Flash bid panel
      const bidPanel = document.getElementById('liveBidPanel');
      bidPanel.classList.remove('bid-flash');
      void bidPanel.offsetWidth; // trigger reflow
      bidPanel.classList.add('bid-flash');

      // Update UI
      updateLiveBidDisplay(car);
      renderBidLogs(car);

      // If it's the hero lot (#1), update hero display as well
      if (car.id === 1) {
        document.getElementById('heroLiveBid').textContent = formatCurrency(newAmount);
      }

      showToast(`Bid Placed: ${formatCurrency(newAmount)} submitted by ${userState.bidderPaddle}!`, "success");

      // Auto simulate counter-bid in 12 seconds if someone is playing
      simulateCounterBidder(car);
    }

    // Simulated opposing international bidder response
    function simulateCounterBidder(car) {
      setTimeout(() => {
        // 50% chance a rival bidder bumps by 10k or 25k
        if (Math.random() > 0.45 && activeLiveLotId === car.id) {
          const bump = [10000, 25000, 50000][Math.floor(Math.random() * 3)];
          car.currentBid += bump;
          car.bidsCount++;

          const opponents = [
            "Phone Consignor via Geneva Desk",
            "Collector #712 (St. Moritz)",
            "Paddle #903 (Monaco Salon)",
            "Private Syndicate (Doha)"
          ];
          const rival = opponents[Math.floor(Math.random() * opponents.length)];

          car.recentBids.unshift({
            bidder: rival,
            amount: car.currentBid,
            time: "Just now"
          });

          playLuxuryChime('gavel');
          updateLiveBidDisplay(car);
          renderBidLogs(car);
          showToast(`Floor Alert: ${rival} counter-bid ${formatCurrency(car.currentBid)}!`, "warning");
        }
      }, 9000);
    }

    /* ==========================================================================
       6. PAID VIP MEMBERSHIP & VERIFICATION CHECKOUT FLOW
       ========================================================================== */
    let selectedTierPlan = 'collector';
    let selectedTierPrice = 299;

    function openVipModal() {
      const modal = document.getElementById('vipModal');
      const card = document.getElementById('vipModalCard');
      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        card.classList.remove('scale-95');
      }, 10);
    }

    function closeVipModal() {
      const modal = document.getElementById('vipModal');
      const card = document.getElementById('vipModalCard');
      modal.classList.add('opacity-0');
      card.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
        cancelCheckout();
      }, 250);
    }

    function selectTier(tierName) {
      if (tierName === 'explorer') {
        userState.tier = 'explorer';
        userState.isVerified = false;
        userState.bidderPaddle = null;
        updateUserStateUI();
        closeVipModal();
        showToast("Switched to Guest Explorer tier.", "info");
      }
    }

    function startVerificationCheckout(tier, price) {
      selectedTierPlan = tier;
      selectedTierPrice = price;
      
      const container = document.getElementById('checkoutStepContainer');
      const title = document.getElementById('checkoutPlanTitle');
      const btnText = document.getElementById('paySubmitText');

      container.classList.remove('hidden');
      if (tier === 'collector') {
        title.textContent = `Verified Collector Membership ($${price}/year)`;
        btnText.textContent = `Process $${price} & Issue Paddle`;
      } else {
        title.textContent = `Prestige Connoisseur Patron ($${price}/year)`;
        btnText.textContent = `Process $${price} & Unlock Unlimited Credit`;
      }

      container.scrollIntoView({ behavior: 'smooth' });
    }

    function cancelCheckout() {
      document.getElementById('checkoutStepContainer').classList.add('hidden');
    }

    function processMembershipPayment(e) {
      e.preventDefault();
      const nameInput = document.getElementById('billingName').value.trim();
      const kycInput = document.getElementById('billingKyc').value.trim();
      const cardInput = document.getElementById('billingCard').value.trim();

      if (!nameInput || !kycInput || !cardInput) {
        showToast("Please complete all verification fields.", "error");
        return;
      }

      // Simulate network / KYC processing
      const submitBtn = document.getElementById('paySubmitBtn');
      submitBtn.disabled = true;
      submitBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Authenticating with AML Registry...`;

      setTimeout(() => {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `<i class="fa-solid fa-lock text-xs"></i> <span>Confirm & Activate VIP Membership</span>`;

        // Update state
        userState.tier = selectedTierPlan;
        userState.name = nameInput;
        userState.isVerified = true;
        // Generate random luxury paddle
        userState.bidderPaddle = "Paddle #" + Math.floor(100 + Math.random() * 899);
        userState.creditLimit = selectedTierPlan === 'prestige' ? 25000000 : 2500000;

        playLuxuryChime('success');
        updateUserStateUI();
        closeVipModal();

        showToast(`Congratulations ${userState.name}! You are now an Accredited VIP Bidder (${userState.bidderPaddle}) with $${(userState.creditLimit/1000000).toFixed(1)}M limit.`, "success");
      }, 1600);
    }

    function updateUserStateUI() {
      const navTier = document.getElementById('navTierName');
      const vipBtnText = document.getElementById('vipBtnText');
      const vipBtn = document.getElementById('vipMembershipBtn');

      if (userState.isVerified) {
        const tierTitle = userState.tier === 'prestige' ? 'Prestige Patron' : 'Verified Collector';
        navTier.innerHTML = `<span class="text-emerald-400 font-bold"><i class="fa-solid fa-circle-check"></i> ${tierTitle}</span> (${userState.bidderPaddle})`;
        vipBtnText.textContent = `${userState.bidderPaddle} Active`;
        vipBtn.className = "relative group overflow-hidden px-4 sm:px-5 py-2.5 rounded-lg text-xs sm:text-sm font-semibold tracking-wide border border-emerald-500 bg-emerald-500/20 text-emerald-300 hover:bg-emerald-500/30 transition-all flex items-center gap-2";
      } else {
        navTier.textContent = "Guest Explorer (Unverified)";
        vipBtnText.textContent = "Register as VIP Bidder";
        vipBtn.className = "relative group overflow-hidden px-4 sm:px-5 py-2.5 rounded-lg text-xs sm:text-sm font-semibold tracking-wide border border-gold-500/60 bg-gradient-to-r from-gold-600 via-gold-500 to-gold-400 text-black shadow-lg shadow-gold-500/20 hover:shadow-gold-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center gap-2";
      }
    }

    function downloadConditionReport() {
      if (!userState.isVerified) {
        openVipModal();
        showToast("Full condition reports & dyno scans require Verified Collector membership.", "warning");
        return;
      }
      playLuxuryChime('gavel');
      showToast("Generating certified unredacted PDF dossier with cryptographic stamp...", "success");
      setTimeout(() => {
        showToast("Download started: AURELIA_LOT42_ARCHIVAL_DOSSIER.pdf", "info");
      }, 1000);
    }

    /* ==========================================================================
       7. CATALOGUE FILTERING & RENDERING
       ========================================================================== */
    let currentEraFilter = 'all';

    function filterCars(era, btn) {
      currentEraFilter = era;
      document.querySelectorAll('#eraFilterContainer .filter-pill').forEach(b => {
        b.className = "filter-pill px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-surface border border-white/10 text-slate-300 hover:text-white hover:border-gold-500/50 transition-all";
      });
      btn.className = "filter-pill px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-gold-500 text-black border border-gold-400 transition-all";
      applyFilters();
    }

    function applyFilters() {
      const status = document.getElementById('statusFilter').value;
      const search = document.getElementById('carSearchInput').value.toLowerCase().trim();

      const filtered = VINTAGE_VAULT.filter(car => {
        const matchesEra = (currentEraFilter === 'all' || car.era === currentEraFilter);
        const matchesStatus = (status === 'all' || car.status === status);
        const matchesSearch = car.title.toLowerCase().includes(search) || 
                              car.vin.toLowerCase().includes(search) || 
                              car.engine.toLowerCase().includes(search);
        return matchesEra && matchesStatus && matchesSearch;
      });

      renderCatalogue(filtered);
    }

    function renderCatalogue(carsList) {
      const grid = document.getElementById('carsCatalogueGrid');
      if (!carsList || carsList.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full py-16 text-center text-slate-500">
            <i class="fa-solid fa-car-tunnel text-4xl mb-3 text-gold-500/40"></i>
            <p class="font-serif text-lg text-white">No historical machines match this filter criteria.</p>
            <p class="text-xs mt-1">Try resetting the era or search query.</p>
          </div>
        `;
        return;
      }

      grid.innerHTML = carsList.map(car => {
        const isLive = car.status === 'live';
        const isSold = car.status === 'sold';
        const isSaved = userState.watchlist.includes(car.id);

        return `
          <div class="glass-panel rounded-2xl overflow-hidden group hover:border-gold-500/50 transition-all duration-300 flex flex-col justify-between">
            <div>
              <!-- Image Container -->
              <div class="relative h-56 w-full overflow-hidden bg-black">
                <img src="${car.image}" alt="${car.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-black/30"></div>
                
                <!-- Lot & Status Badges -->
                <div class="absolute top-3 left-3 flex gap-2">
                  <span class="px-2.5 py-0.5 rounded bg-black/80 border border-gold-500/30 text-gold-400 text-[10px] font-mono font-bold">LOT #${car.lotNumber}</span>
                  ${isLive ? '<span class="px-2.5 py-0.5 rounded bg-red-600/90 text-white text-[10px] font-bold uppercase tracking-wider flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-white animate-ping"></span> Live</span>' : ''}
                  ${isSold ? '<span class="px-2.5 py-0.5 rounded bg-slate-800 text-slate-300 text-[10px] font-bold uppercase">Sold</span>' : ''}
                </div>

                <!-- Watchlist icon -->
                <button onclick="toggleWatchlist(${car.id})" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-black/60 border border-white/20 text-white hover:text-gold-400 flex items-center justify-center text-xs transition-colors">
                  <i class="${isSaved ? 'fa-solid text-gold-400' : 'fa-regular'} fa-bookmark"></i>
                </button>

                <div class="absolute bottom-3 left-3 right-3 flex justify-between items-baseline">
                  <span class="text-[10px] uppercase font-bold text-slate-300 tracking-wider font-mono">${car.vin}</span>
                  <span class="text-xs text-gold-400 font-semibold">${car.conditionScore} Concours</span>
                </div>
              </div>

              <!-- Content Body -->
              <div class="p-5 space-y-3">
                <h3 class="font-serif text-lg font-bold text-white group-hover:text-gold-400 transition-colors line-clamp-1">${car.title}</h3>
                <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed">${car.description}</p>
                
                <div class="pt-2 grid grid-cols-2 gap-2 text-xs border-t border-white/5 text-slate-300">
                  <div>
                    <span class="text-[10px] text-slate-500 block">Powertrain</span>
                    <span class="font-medium truncate block">${car.engine.split(' ')[0]} ${car.engine.split(' ')[1] || ''}</span>
                  </div>
                  <div>
                    <span class="text-[10px] text-slate-500 block">Auction Guidance</span>
                    <span class="font-medium text-gold-400 truncate block">${car.estimateRange}</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card Bottom Bar -->
            <div class="p-5 pt-0 flex gap-2">
              <button onclick="openCarDetailModal(${car.id})" class="flex-1 py-2 rounded-lg bg-surfaceLight hover:bg-surface border border-white/10 text-xs font-semibold text-slate-200 transition-all">
                Inspect Lot
              </button>
              ${isLive ? `
                <button onclick="scrollToLiveLot(${car.id})" class="px-4 py-2 rounded-lg bg-gold-500 hover:bg-gold-400 text-black text-xs font-bold uppercase tracking-wider transition-all">
                  Bid Live
                </button>
              ` : `
                <button onclick="openCarDetailModal(${car.id})" class="px-4 py-2 rounded-lg border border-gold-500/40 text-gold-400 hover:bg-gold-500/10 text-xs font-semibold transition-all">
                  Details
                </button>
              `}
            </div>
          </div>
        `;
      }).join('');
    }

    /* ==========================================================================
       8. CAR DETAIL MODAL
       ========================================================================== */
    function openCarDetailModal(carId) {
      const car = VINTAGE_VAULT.find(c => c.id == carId);
      if (!car) return;

      document.getElementById('modalCarEraLot').textContent = `LOT #${car.lotNumber} • ${car.eraLabel.toUpperCase()}`;
      document.getElementById('modalCarName').textContent = car.title;
      document.getElementById('modalCarImage').src = car.image;
      document.getElementById('modalCarEngine').textContent = `${car.engine} (${car.horsepower})`;
      document.getElementById('modalCarVin').textContent = car.vin;
      document.getElementById('modalCarEst').textContent = car.estimateRange;
      document.getElementById('modalCarFullStory').textContent = car.description;

      const note = document.getElementById('modalCarStatusNote');
      const actionBtn = document.getElementById('modalActionBtn');

      if (car.status === 'live') {
        note.textContent = `Live Standing: ${formatCurrency(car.currentBid)} (${car.bidsCount} bids)`;
        actionBtn.textContent = "Take to Live Bidding Floor";
        actionBtn.onclick = () => {
          closeCarDetailModal();
          scrollToLiveLot(car.id);
        };
      } else if (car.status === 'sold') {
        note.textContent = `Completed: Hammer fell at ${formatCurrency(car.currentBid)}`;
        actionBtn.textContent = "View Sale Certificate";
        actionBtn.onclick = () => {
          showToast("Archival certificate available to verified consignors.", "info");
        };
      } else {
        note.textContent = `Upcoming Sale: Lot slated for Monterey Gala`;
        actionBtn.textContent = "Leave Absentee Bid";
        actionBtn.onclick = () => {
          if (!requireVipAccess()) return;
          showToast(`Absentee order registered for Lot #${car.lotNumber}.`, "success");
        };
      }

      const modal = document.getElementById('carDetailModal');
      modal.classList.remove('hidden');
      setTimeout(() => modal.classList.remove('opacity-0'), 10);
    }

    function closeCarDetailModal() {
      const modal = document.getElementById('carDetailModal');
      modal.classList.add('opacity-0');
      setTimeout(() => modal.classList.add('hidden'), 250);
    }

    /* ==========================================================================
       9. WATCHLIST SYSTEM
       ========================================================================== */
    function toggleWatchlistCurrentLot() {
      toggleWatchlist(activeLiveLotId);
    }

    function toggleWatchlist(carId) {
      const idx = userState.watchlist.indexOf(carId);
      const car = VINTAGE_VAULT.find(c => c.id == carId);
      if (idx > -1) {
        userState.watchlist.splice(idx, 1);
        showToast(`Removed "${car ? car.title.substring(0, 22) : 'Car'}..." from Vault Watchlist`, "info");
      } else {
        userState.watchlist.push(carId);
        showToast(`Saved "${car ? car.title.substring(0, 22) : 'Car'}..." to your Watchlist`, "success");
      }
      updateWatchlistBadge();
      updateBookmarkButtonState(activeLiveLotId);
      applyFilters(); // refresh icons on cards
    }

    function updateBookmarkButtonState(carId) {
      const btn = document.getElementById('liveBookmarkBtn');
      if (!btn) return;
      const isSaved = userState.watchlist.includes(carId);
      btn.innerHTML = `<i class="${isSaved ? 'fa-solid text-gold-400' : 'fa-regular'} fa-bookmark"></i>`;
    }

    function updateWatchlistBadge() {
      const badge = document.getElementById('watchlistCountBadge');
      if (badge) badge.textContent = userState.watchlist.length;
    }

    function toggleWatchlistModal() {
      const modal = document.getElementById('watchlistModal');
      if (modal.classList.contains('hidden')) {
        renderWatchlistModalItems();
        modal.classList.remove('hidden');
        setTimeout(() => modal.classList.remove('opacity-0'), 10);
      } else {
        modal.classList.add('opacity-0');
        setTimeout(() => modal.classList.add('hidden'), 250);
      }
    }

    function renderWatchlistModalItems() {
      const container = document.getElementById('watchlistItemsList');
      if (userState.watchlist.length === 0) {
        container.innerHTML = `<p class="text-xs text-slate-400 text-center py-6">Your watchlist is currently empty. Bookmark lots in the Vault to monitor auction times.</p>`;
        return;
      }

      const savedCars = VINTAGE_VAULT.filter(c => userState.watchlist.includes(c.id));
      container.innerHTML = savedCars.map(c => `
        <div class="flex items-center justify-between p-3 rounded-lg bg-surface border border-white/5 gap-3">
          <img src="${c.image}" class="w-14 h-12 rounded object-cover">
          <div class="flex-1 min-w-0">
            <h4 class="text-xs font-bold text-white truncate">${c.title}</h4>
            <span class="text-[10px] text-gold-400 block font-mono">Lot #${c.lotNumber} • ${c.estimateRange}</span>
          </div>
          <div class="flex items-center gap-2">
            <button onclick="toggleWatchlistModal(); scrollToLiveLot(${c.id});" class="p-2 rounded bg-gold-500 hover:bg-gold-400 text-black text-xs font-bold">
              View
            </button>
            <button onclick="toggleWatchlist(${c.id}); renderWatchlistModalItems();" class="text-slate-400 hover:text-red-400 p-1.5 text-xs">
              <i class="fa-solid fa-trash-can"></i>
            </button>
          </div>
        </div>
      `).join('');
    }

    /* ==========================================================================
       10. VALUATION ESTIMATION ENGINE (INTERACTIVE TOOL)
       ========================================================================== */
    function updateMileageLabel(val) {
      document.getElementById('mileageLabel').textContent = parseInt(val).toLocaleString() + " Miles";
    }

    function recalculateValuation() {
      const marque = document.getElementById('calcMarque').value;
      const condition = document.getElementById('calcCondition').value;
      const mileage = parseInt(document.getElementById('calcMileage').value, 10);
      const matchingNumbers = document.getElementById('calcMatchingNumbers').checked;
      const raceHistory = document.getElementById('calcRaceHistory').checked;

      // Base baselines
      let baseLow = 2000000;
      let baseHigh = 2600000;

      if (marque === 'ferrari-v12') {
        baseLow = 12000000;
        baseHigh = 16000000;
      } else if (marque === 'mercedes-sl') {
        baseLow = 1900000;
        baseHigh = 2400000;
      } else if (marque === 'aston-db') {
        baseLow = 950000;
        baseHigh = 1300000;
      } else if (marque === 'porsche-rs') {
        baseLow = 280000;
        baseHigh = 420000;
      } else if (marque === 'bugatti-prewar') {
        baseLow = 28000000;
        baseHigh = 36000000;
      }

      // Condition multipliers
      let condMultiplier = 1.0;
      if (condition === 'concours') condMultiplier = 1.25;
      else if (condition === 'excellent') condMultiplier = 1.05;
      else if (condition === 'driver') condMultiplier = 0.85;
      else if (condition === 'project') condMultiplier = 0.55;

      // Mileage factor (subtle on ultra vintage)
      const mileagePenalty = Math.max(0.85, 1 - (mileage / 350000));

      // Provenance bonuses
      const matchingMultiplier = matchingNumbers ? 1.20 : 0.80;
      const raceMultiplier = raceHistory ? 1.30 : 1.0;

      const finalLow = Math.round((baseLow * condMultiplier * mileagePenalty * matchingMultiplier * raceMultiplier) / 50000) * 50000;
      const finalHigh = Math.round((baseHigh * condMultiplier * mileagePenalty * matchingMultiplier * raceMultiplier) / 50000) * 50000;

      document.getElementById('calculatedEstimateOutput').textContent = 
        `${formatCurrency(finalLow)} - ${formatCurrency(finalHigh)}`;
    }

    function requestConsignmentAudit() {
      if (!userState.isVerified) {
        openVipModal();
        showToast("Consignment requires verified identity credentials.", "warning");
        return;
      }
      showToast("Consignment docket initialized. A Senior Marque Specialist will contact you within 4 hours.", "success");
    }

    /* ==========================================================================
       11. UTILITY FUNCTIONS (CURRENCY & TOAST SYSTEM)
       ========================================================================== */
    function formatCurrency(amount) {
      return "$" + Number(amount).toLocaleString('en-US');
    }

    function showToast(message, type = 'info') {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');

      let icon = 'fa-circle-info';
      let border = 'border-gold-500/40 text-slate-200';
      if (type === 'success') {
        icon = 'fa-circle-check text-emerald-400';
        border = 'border-emerald-500/50 text-slate-100';
      } else if (type === 'error') {
        icon = 'fa-circle-exclamation text-red-400';
        border = 'border-red-500/50 text-slate-100';
      } else if (type === 'warning') {
        icon = 'fa-triangle-exclamation text-amber-400';
        border = 'border-amber-500/50 text-slate-100';
      }

      toast.className = `p-4 rounded-xl glass-panel-elevated ${border} text-xs font-medium max-w-sm flex items-start gap-3 shadow-2xl pointer-events-auto transform translate-y-2 opacity-0 transition-all duration-300`;
      toast.innerHTML = `
        <i class="fa-solid ${icon} mt-0.5 text-sm"></i>
        <div class="flex-1">${message}</div>
      `;

      container.appendChild(toast);
      setTimeout(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      }, 10);

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-x-2');
        setTimeout(() => toast.remove(), 300);
      }, 4200);
    }
  </script>
