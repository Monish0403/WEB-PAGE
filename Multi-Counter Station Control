    function calcDenominations() {
      const b100 = parseInt(document.getElementById('bill_100').value) || 0;
      const b50 = parseInt(document.getElementById('bill_50').value) || 0;
      const b20 = parseInt(document.getElementById('bill_20').value) || 0;
      const bSmall = parseFloat(document.getElementById('bill_small').value) || 0;

      const totalCounted = (b100 * 100) + (b50 * 50) + (b20 * 20) + bSmall;
      const badge = document.getElementById('denomSumBadge');
      const diffAlert = document.getElementById('denomDiffAlert');

      badge.innerText = `Count: $${totalCounted.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;

      if (Math.abs(totalCounted - inputAmount) < 0.01) {
        diffAlert.className = 'mt-2.5 text-[11px] font-mono flex items-center justify-between text-emerald-400';
        diffAlert.innerHTML = `<span>Tray Tally Matches Input Amount Exactly &check;</span> <button onclick="autoFillDenoms()" class="text-slate-400 hover:text-white underline">Auto-balance</button>`;
      } else {
        const diff = inputAmount - totalCounted;
        diffAlert.className = 'mt-2.5 text-[11px] font-mono flex items-center justify-between text-amber-400 font-bold';
        diffAlert.innerHTML = `<span>Discrepancy: ${diff > 0 ? 'Under by' : 'Over by'} $${Math.abs(diff).toFixed(2)}</span> <button onclick="autoFillDenoms()" class="text-slate-300 hover:text-white underline">Rebalance to Tender</button>`;
      }
    }

    function autoFillDenoms() {
      let remaining = Math.floor(inputAmount);
      const b100 = Math.floor(remaining / 100);
      remaining %= 100;

      const b50 = Math.floor(remaining / 50);
      remaining %= 50;

      const b20 = Math.floor(remaining / 20);
      remaining %= 20;

      document.getElementById('bill_100').value = b100;
      document.getElementById('bill_50').value = b50;
      document.getElementById('bill_20').value = b20;
      document.getElementById('bill_small').value = remaining + (inputAmount % 1);

      calcDenominations();
    }

