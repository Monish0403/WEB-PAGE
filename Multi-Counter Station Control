<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>OmniForex Desk | Global Currency & Multi-Counter Exchange System</title>
  
  <!-- Inter & JetBrains Mono Fonts for Bloomberg/Fintech Aesthetics -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            brand: {
              50: '#ecfdf5',
              100: '#d1fae5',
              400: '#34d399',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
              900: '#064e3b',
              950: '#022c22',
            },
            navy: {
              800: '#1e293b',
              850: '#141e30',
              900: '#0f172a',
              950: '#090d16',
            },
            terminal: {
              green: '#00ff66',
              amber: '#ffb703',
              cyan: '#00e5ff',
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Custom Scrollbars */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.6); }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #475569; }

    /* Animated Ticker Marquee */
    @keyframes tickerScroll {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .ticker-wrapper {
      display: flex;
      width: max-content;
      animation: tickerScroll 42s linear infinite;
    }
    .ticker-wrapper:hover {
      animation-play-state: paused;
    }

    /* Print Slip Styles */
    @media print {
      body * {
        visibility: hidden !important;
      }
      #printableReceipt, #printableReceipt * {
        visibility: visible !important;
      }
      #printableReceipt {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        margin: 0;
        padding: 16px;
        background: white !important;
        color: black !important;
        box-shadow: none !important;
        border: none !important;
      }
      .no-print {
        display: none !important;
      }
    }

    /* Pulse Glows */
    .glow-green {
      box-shadow: 0 0 15px rgba(16, 185, 129, 0.25);
    }
    .glow-blue {
      box-shadow: 0 0 15px rgba(59, 130, 246, 0.25);
    }
  </style>
</head>
<body class="bg-[#090d16] text-slate-100 min-h-screen flex flex-col font-sans selection:bg-brand-500 selection:text-black">

  <!-- ================= TOP INSTITUTIONAL STATUS BAR ================= -->
  <header class="bg-navy-950/90 border-b border-slate-800/80 sticky top-0 z-40 backdrop-blur-md">
    <div class="max-w-[1780px] mx-auto px-4 lg:px-6 h-16 flex items-center justify-between gap-4">
      
      <!-- Logo & Branch Branding -->
      <div class="flex items-center gap-3.5 shrink-0">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 via-emerald-500 to-teal-400 p-[1px] flex items-center justify-center shadow-lg shadow-emerald-950/50">
          <div class="w-full h-full bg-navy-900 rounded-[11px] flex items-center justify-center text-brand-400">
            <i data-lucide="globe-2" class="w-5 h-5"></i>
          </div>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-extrabold text-lg tracking-tight text-white flex items-center gap-1">
              Omni<span class="text-brand-400">Forex</span>
            </span>
            <span class="text-[10px] font-mono uppercase bg-slate-800 text-brand-400 px-1.5 py-0.5 rounded font-bold border border-slate-700">
              DESK v4.8
            </span>
          </div>
          <p class="text-[11px] text-slate-400 font-mono flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            LONDON HEATHROW T5 (LHR-FX-02) &bull; VAULT ID: #VT-8809
          </p>
        </div>
      </div>

      <!-- Live Clock & Market Engine Indicators -->
      <div class="hidden xl:flex items-center gap-6 font-mono text-xs text-slate-400 border-x border-slate-800 px-6 h-10">
        <div>
          <span class="text-slate-500 uppercase text-[10px] block">SYSTEM UTC TIME</span>
          <span id="utcClock" class="text-slate-200 font-bold">--:--:-- UTC</span>
        </div>
        <div>
          <span class="text-slate-500 uppercase text-[10px] block">LOCAL TERMINAL</span>
          <span id="localClock" class="text-emerald-400 font-bold">--:--:-- BST</span>
        </div>
        <div>
          <span class="text-slate-500 uppercase text-[10px] block">FEED SOURCE</span>
          <span class="text-cyan-400 font-semibold flex items-center gap-1">
            <i data-lucide="satellite" class="w-3.5 h-3.5"></i> REUTERS FIX 4.4
          </span>
        </div>
      </div>

      <!-- Quick Audio & Global Terminal Actions -->
      <div class="flex items-center gap-2.5">
        <!-- Audio Cue Toggle -->
        <button id="soundToggleBtn" onclick="toggleAudioChime()" class="px-3 py-1.5 rounded-lg border border-slate-800 bg-slate-900/80 hover:bg-slate-800 text-xs font-mono text-slate-300 flex items-center gap-2 transition-all">
          <i id="soundIcon" data-lucide="volume-2" class="w-4 h-4 text-brand-400"></i>
          <span class="hidden sm:inline">Chime Alerts: <strong id="soundStatusText" class="text-brand-400">ON</strong></span>
        </button>

        <!-- Pre-Order / Customer Token Modal Button -->
        <button onclick="openCustomerModal()" class="px-3.5 py-1.5 rounded-lg bg-blue-600/20 hover:bg-blue-600/30 border border-blue-500/40 text-blue-300 text-xs font-semibold flex items-center gap-1.5 transition-all">
          <i data-lucide="ticket" class="w-4 h-4 text-blue-400"></i>
          <span>Issue Customer Token</span>
        </button>

        <!-- Manager Override Badge / Status -->
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800">
          <div class="w-7 h-7 rounded-full bg-brand-500/20 text-brand-400 flex items-center justify-center font-bold text-xs border border-brand-500/30">
            TS
          </div>
          <div class="text-left hidden md:block">
            <span class="text-[11px] font-bold text-white block leading-tight">T. Sullivan</span>
            <span class="text-[10px] text-slate-400 font-mono block leading-tight">Chief Teller #409</span>
          </div>
        </div>
      </div>

    </div>

    <!-- STREAMING RATE TICKER -->
    <div class="bg-black/60 border-t border-slate-800/80 overflow-hidden py-1.5 flex items-center">
      <div class="shrink-0 bg-slate-900 text-emerald-400 px-3 py-0.5 text-[11px] font-mono font-bold tracking-wider uppercase border-r border-slate-800 flex items-center gap-1.5 z-10">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
        STREAMING FX
      </div>
      <div class="overflow-hidden relative w-full flex">
        <div id="liveTickerTape" class="ticker-wrapper font-mono text-xs text-slate-300 flex items-center gap-8 pl-4">
          <!-- Populated dynamically via JS -->
        </div>
      </div>
    </div>
  </header>

  <!-- ================= 1. MULTI-COUNTER DESK SELECTOR ================= -->
  <section class="max-w-[1780px] mx-auto w-full px-4 lg:px-6 pt-5 pb-3">
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-2">
        <i data-lucide="layout-grid" class="w-4 h-4 text-brand-400"></i>
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 font-mono">
          Branch Station Switchboard (4 Active Counters)
        </h2>
      </div>
      <div class="flex items-center gap-2 text-xs font-mono text-slate-400">
        <span>Global Cash Limit: <strong class="text-white">£450,000.00</strong></span>
        <span>&bull;</span>
        <span class="text-brand-400 flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-brand-400"></span> 4 OF 4 ONLINE
        </span>
      </div>
    </div>

    <!-- 4 Counter Station Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5" id="counterStationGrid">
      <!-- Generated via JS -->
    </div>
  </section>

  <!-- ================= MAIN WORKSPACE (SPLIT 3 COLUMNS) ================= -->
  <main class="max-w-[1780px] mx-auto w-full px-4 lg:px-6 py-3 flex-1 grid grid-cols-1 xl:grid-cols-12 gap-5">

    <!-- LEFT COLUMN (5 COLS): TELLER POS EXCHANGE TERMINAL -->
    <div class="xl:col-span-5 flex flex-col gap-4">
      
      <!-- The Exchange Box -->
      <div class="bg-navy-900/90 rounded-2xl border border-slate-800/90 shadow-2xl p-5 relative overflow-hidden backdrop-blur-sm">
        
        <!-- Header / Desk Mode -->
        <div class="flex items-center justify-between border-b border-slate-800/90 pb-4 mb-4">
          <div>
            <div class="flex items-center gap-2">
              <span id="activeCounterBadge" class="bg-brand-500/20 text-brand-400 font-mono text-xs font-extrabold px-2.5 py-0.5 rounded-md border border-brand-500/30">
                COUNTER 1
              </span>
              <h3 id="activeCounterTitle" class="font-bold text-slate-100 text-base">Retail Cash Desk</h3>
            </div>
            <p id="activeCounterProfileDesc" class="text-xs text-slate-400 font-mono mt-0.5">Rate Profile: Standard Retail Cash Spread (+1.85%)</p>
          </div>

          <!-- Trade Mode Toggle (BUY vs SELL) -->
          <div class="flex p-1 bg-slate-950 rounded-xl border border-slate-800">
            <button id="btnModeBuy" onclick="setTradeDirection('BUY')" class="px-4 py-1.5 rounded-lg text-xs font-extrabold tracking-wide font-mono transition-all bg-emerald-600 text-white shadow">
              WE BUY
            </button>
            <button id="btnModeSell" onclick="setTradeDirection('SELL')" class="px-4 py-1.5 rounded-lg text-xs font-extrabold tracking-wide font-mono transition-all text-slate-400 hover:text-slate-200">
              WE SELL
            </button>
          </div>
        </div>

        <!-- INPUT 1: GIVEN CASH (FROM CURRENCY) -->
        <div class="bg-slate-950/70 p-4 rounded-xl border border-slate-800/80 mb-3 focus-within:border-brand-500/60 transition-colors">
          <div class="flex items-center justify-between text-xs text-slate-400 font-mono mb-2">
            <span id="labelFromText" class="font-semibold text-slate-300 flex items-center gap-1.5">
              <i data-lucide="hand-coins" class="w-3.5 h-3.5 text-brand-400"></i> CUSTOMER HANDS OVER:
            </span>
            <span class="text-slate-500">Physical Tender</span>
          </div>

          <div class="flex items-center justify-between gap-3">
            <div class="relative flex-1">
              <input 
                type="number" 
                id="inputFromAmount" 
                value="1000" 
                step="any"
                min="1" 
                oninput="handleAmountInput(this.value)" 
                class="w-full bg-transparent text-2xl lg:text-3xl font-extrabold font-mono text-white placeholder-slate-600 outline-none"
                placeholder="0.00"
              />
            </div>

            <!-- Currency Selector (From) -->
            <div class="shrink-0">
              <button onclick="toggleCurrencyDropdown('from')" id="btnSelectFromCurr" class="flex items-center gap-2 bg-slate-900 hover:bg-slate-800 border border-slate-700/80 px-3.5 py-2 rounded-xl text-sm font-bold text-white transition-all">
                <span id="flagFrom" class="text-lg">🇺🇸</span>
                <span id="codeFrom" class="font-mono">USD</span>
                <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400"></i>
              </button>
            </div>
          </div>

          <div class="flex items-center justify-between text-[11px] text-slate-400 font-mono mt-2 pt-2 border-t border-slate-900">
            <span id="fromCurrencyName">United States Dollar</span>
            <span>Local Vault In Stock: <strong id="fromVaultStock" class="text-slate-200">$48,250</strong></span>
          </div>
        </div>

        <!-- SWAP & RATE CONVERSION BADGE -->
        <div class="flex items-center justify-between my-2 px-2">
          <button onclick="swapCurrencies()" title="Invert Currencies" class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700 transition-all flex items-center gap-1 text-xs font-mono">
            <i data-lucide="arrow-up-down" class="w-4 h-4 text-brand-400"></i>
            <span>Invert Pair</span>
          </button>

          <!-- Current Applied Exchange Rate -->
          <div class="text-right font-mono text-xs">
            <span class="text-slate-400 block text-[10px]">APPLIED BOARD RATE</span>
            <span id="appliedRateLabel" class="text-brand-400 font-extrabold text-sm">
              1 USD = 0.7845 GBP
            </span>
          </div>
        </div>

        <!-- INPUT 2: CONVERTED DISPENSED CASH (TO CURRENCY) -->
        <div class="bg-slate-950/70 p-4 rounded-xl border border-slate-800/80 mb-4 focus-within:border-brand-500/60 transition-colors">
          <div class="flex items-center justify-between text-xs text-slate-400 font-mono mb-2">
            <span id="labelToText" class="font-semibold text-slate-300 flex items-center gap-1.5">
              <i data-lucide="banknote" class="w-3.5 h-3.5 text-cyan-400"></i> TELLER DISPENSES:
            </span>
            <span class="text-slate-500">Payout Net Total</span>
          </div>

          <div class="flex items-center justify-between gap-3">
            <div class="relative flex-1">
              <div id="outputToAmount" class="text-2xl lg:text-3xl font-extrabold font-mono text-emerald-400 truncate">
                784.50
              </div>
            </div>

            <!-- Currency Selector (To) -->
            <div class="shrink-0">
              <button onclick="toggleCurrencyDropdown('to')" id="btnSelectToCurr" class="flex items-center gap-2 bg-slate-900 hover:bg-slate-800 border border-slate-700/80 px-3.5 py-2 rounded-xl text-sm font-bold text-white transition-all">
                <span id="flagTo" class="text-lg">🇬🇧</span>
                <span id="codeTo" class="font-mono">GBP</span>
                <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400"></i>
              </button>
            </div>
          </div>

          <div class="flex items-center justify-between text-[11px] text-slate-400 font-mono mt-2 pt-2 border-t border-slate-900">
            <span id="toCurrencyName">British Pound Sterling</span>
            <span>Drawer Balance: <strong id="toVaultStock" class="text-slate-200">£19,400</strong></span>
          </div>
        </div>

        <!-- PHYSICAL DENOMINATION CALCULATOR COLLAPSIBLE -->
        <div class="border border-slate-800 rounded-xl overflow-hidden mb-4 bg-slate-950/40">
          <button type="button" onclick="toggleDenomAccordion()" class="w-full px-4 py-2.5 flex items-center justify-between text-xs font-mono font-bold text-slate-300 hover:bg-slate-800/50 transition-colors">
            <span class="flex items-center gap-2">
              <i data-lucide="calculator" class="w-4 h-4 text-brand-400"></i>
              <span>Cash Denomination Breakdown & Cash Balancing</span>
            </span>
            <div class="flex items-center gap-2">
              <span id="denomSumBadge" class="text-emerald-400 font-bold bg-emerald-950/70 px-2 py-0.5 rounded border border-emerald-800/40">
                Count: $1,000.00
              </span>
              <i id="denomChevron" data-lucide="chevron-down" class="w-4 h-4 text-slate-400 transition-transform"></i>
            </div>
          </button>

          <div id="denomBody" class="p-4 border-t border-slate-800/80 bg-slate-950/80">
            <p class="text-[11px] text-slate-400 font-mono mb-2.5">
              Enter physical banknote counts received from customer to verify cash tray parity:
            </p>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs font-mono">
              <div class="bg-slate-900 p-2 rounded-lg border border-slate-800">
                <span class="text-slate-400 block text-[10px]">$100 Bills</span>
                <div class="flex items-center gap-1.5 mt-1">
                  <input type="number" min="0" value="10" id="bill_100" oninput="calcDenominations()" class="w-full bg-slate-950 text-white px-1.5 py-1 rounded border border-slate-700 text-center font-bold">
                </div>
              </div>
              <div class="bg-slate-900 p-2 rounded-lg border border-slate-800">
                <span class="text-slate-400 block text-[10px]">$50 Bills</span>
                <div class="flex items-center gap-1.5 mt-1">
                  <input type="number" min="0" value="0" id="bill_50" oninput="calcDenominations()" class="w-full bg-slate-950 text-white px-1.5 py-1 rounded border border-slate-700 text-center font-bold">
                </div>
              </div>
              <div class="bg-slate-900 p-2 rounded-lg border border-slate-800">
                <span class="text-slate-400 block text-[10px]">$20 Bills</span>
                <div class="flex items-center gap-1.5 mt-1">
                  <input type="number" min="0" value="0" id="bill_20" oninput="calcDenominations()" class="w-full bg-slate-950 text-white px-1.5 py-1 rounded border border-slate-700 text-center font-bold">
                </div>
              </div>
              <div class="bg-slate-900 p-2 rounded-lg border border-slate-800">
                <span class="text-slate-400 block text-[10px]">$10 / $5 / Coins</span>
                <div class="flex items-center gap-1.5 mt-1">
                  <input type="number" min="0" value="0" id="bill_small" oninput="calcDenominations()" class="w-full bg-slate-950 text-white px-1.5 py-1 rounded border border-slate-700 text-center font-bold">
                </div>
              </div>
            </div>
            <div id="denomDiffAlert" class="mt-2.5 text-[11px] font-mono flex items-center justify-between text-emerald-400">
              <span>Tray Tally Matches Input Amount Exactly &check;</span>
              <button onclick="autoFillDenoms()" class="text-slate-400 hover:text-white underline">Auto-balance to input</button>
            </div>
          </div>
        </div>

        <!-- COMPLIANCE & CUSTOMER KYC SECTION -->
        <div class="bg-slate-950/90 rounded-xl border border-slate-800 p-4 mb-4">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-mono font-bold text-slate-300 flex items-center gap-2">
              <i data-lucide="shield-check" class="w-4 h-4 text-emerald-400"></i>
              AML / KYC AUDIT REGISTRY
            </span>
            <span id="amlRiskBadge" class="text-[10px] font-mono font-extrabold px-2 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800">
              TIER 1 &bull; STANDARD RISK
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs font-mono">
            <div>
              <label class="text-[10px] text-slate-400 uppercase block mb-1">Customer Full Name *</label>
              <input type="text" id="custName" value="James H. Wilson" placeholder="Full legal name" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-2 text-white outline-none focus:border-brand-500">
            </div>
            <div>
              <label class="text-[10px] text-slate-400 uppercase block mb-1">Passport / Gov ID No. *</label>
              <input type="text" id="custId" value="GBR-994821034" placeholder="Passport or National ID" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-2 text-white outline-none focus:border-brand-500">
            </div>
            <div>
              <label class="text-[10px] text-slate-400 uppercase block mb-1">Nationality *</label>
              <select id="custNat" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-2 text-white outline-none focus:border-brand-500">
                <option value="United Kingdom">United Kingdom (GBR)</option>
                <option value="United States">United States (USA)</option>
                <option value="Germany">Germany (DEU)</option>
                <option value="France">France (FRA)</option>
                <option value="Japan">Japan (JPN)</option>
                <option value="India">India (IND)</option>
                <option value="United Arab Emirates">UAE (ARE)</option>
                <option value="Canada">Canada (CAN)</option>
              </select>
            </div>
            <div>
              <label class="text-[10px] text-slate-400 uppercase block mb-1">Purpose of Exchange</label>
              <select id="custPurpose" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-2 text-white outline-none focus:border-brand-500">
                <option value="Personal Leisure Travel">Holiday / Leisure Travel</option>
                <option value="Business Trip Expense">Business & Corporate Expense</option>
                <option value="Overseas Tuition Remittance">Overseas Tuition Fee</option>
                <option value="Expatriate Living Allowance">Family Remittance</option>
              </select>
            </div>
          </div>

          <!-- Threshold AML Alert Prompt (Auto appears when > $10,000) -->
          <div id="amlOverrideBanner" class="hidden mt-3 p-2.5 rounded-lg bg-amber-950/80 border border-amber-600/60 text-amber-300 text-xs font-mono flex items-center justify-between">
            <div class="flex items-center gap-2">
              <i data-lucide="alert-triangle" class="w-4 h-4 text-amber-400 shrink-0"></i>
              <span>High-Value (> $10k equivalent): Manager KYC Sign-off Required.</span>
            </div>
            <button onclick="approveManagerOverride()" class="px-2 py-1 bg-amber-600 hover:bg-amber-500 text-black font-bold text-[10px] rounded uppercase shrink-0">
              Override Auth
            </button>
          </div>
        </div>

        <!-- FEE & FINANCIAL RECONCILIATION SUMMARY -->
        <div class="bg-slate-950/60 rounded-xl p-3.5 border border-slate-800 text-xs font-mono space-y-1.5 mb-5">
          <div class="flex justify-between text-slate-400">
            <span>Interbank Mid-Market Base:</span>
            <span id="summaryMidTotal" class="text-slate-200">£795.12</span>
          </div>
          <div class="flex justify-between text-slate-400">
            <span>Desk Spread Margin:</span>
            <span id="summarySpreadFee" class="text-slate-200">-£10.62 (1.85%)</span>
          </div>
          <div class="flex justify-between text-slate-400">
            <span>Terminal Regulatory Duty / VAT:</span>
            <span id="summaryVat" class="text-slate-200">£0.00 (Exempt FX)</span>
          </div>
          <div class="flex justify-between text-slate-400">
            <span>Standard Commission / Counter Fee:</span>
            <span id="summaryFee" class="text-emerald-400 font-bold">FREE (£0.00)</span>
          </div>
          <div class="pt-2 border-t border-slate-800 flex justify-between items-baseline font-bold text-sm">
            <span class="text-white uppercase tracking-wider">Net Amount Payable to Customer:</span>
            <span id="summaryGrandTotal" class="text-emerald-400 text-base font-extrabold font-mono">£784.50</span>
          </div>
