    function executeExchangeTrade() {
      const custName = document.getElementById('custName').value.trim();
      const custId = document.getElementById('custId').value.trim();

      if (!custName || !custId) {
        alert('Compliance Block: Customer Legal Name and Government ID are mandatory.');
