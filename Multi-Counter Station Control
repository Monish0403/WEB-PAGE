    function recalculateExchange() {
      const margin = getActiveMargin() / 100;
      const fromObj = CURRENCIES[selectedFromCode];
      const toObj = CURRENCIES[selectedToCode];

      let effectiveRate = 1.0;
      let outputTotal = 0;
      let midEquivalent = 0;

      if (tradeDirection === 'BUY') {
        // Customer gives Foreign (e.g. USD), gets local GBP
        // 1 Foreign = (1 / midPerGbp) * (1 - margin) GBP
        const midInGbp = 1 / fromObj.midPerGbp;
        effectiveRate = midInGbp * (1 - margin);
        outputTotal = inputAmount * effectiveRate;
        midEquivalent = inputAmount * midInGbp;
        
        document.getElementById('appliedRateLabel').innerText = `1 ${selectedFromCode} = ${effectiveRate.toFixed(4)} GBP`;
      } else {
        // Customer gives local GBP, gets Foreign (e.g. USD)
        // 1 GBP = midPerGbp * (1 - margin) Foreign
        effectiveRate = toObj.midPerGbp * (1 - margin);
        outputTotal = inputAmount * effectiveRate;
        midEquivalent = inputAmount * toObj.midPerGbp;

        document.getElementById('appliedRateLabel').innerText = `1 GBP = ${effectiveRate.toFixed(4)} ${selectedToCode}`;
      }

      // Populate Display Values
      document.getElementById('outputToAmount').innerText = outputTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('summaryGrandTotal').innerText = `${toObj.symbol}${outputTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ${selectedToCode}`;
      
      const spreadDifference = Math.abs(midEquivalent - outputTotal);
      document.getElementById('summaryMidTotal').innerText = `${toObj.symbol}${midEquivalent.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      document.getElementById('summarySpreadFee').innerText = `-${toObj.symbol}${spreadDifference.toFixed(2)} (${(margin * 100).toFixed(2)}%)`;

      // Update denomination count parity
      autoFillDenoms();
      checkAmlThreshold();
    }

