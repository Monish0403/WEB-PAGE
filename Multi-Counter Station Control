      const container = document.getElementById('auditLogStream');
      document.getElementById('auditCountBadge').innerText = `${auditLogs.length} Deals`;

      container.innerHTML = auditLogs.map(log => `
        <div class="py-2 flex items-center justify-between">
          <div>
            <div class="flex items-center gap-1.5">
              <span class="font-bold text-white">${log.id}</span>
              <span class="text-[9px] px-1 rounded bg-slate-800 text-slate-300">C0${log.counter}</span>
              <span class="text-[9px] font-bold ${log.type === 'BUY' ? 'text-emerald-400' : 'text-blue-400'}">${log.type}</span>
            </div>
            <div class="text-[10px] text-slate-400 truncate max-w-[140px]">${log.cust} &bull; ${log.time}</div>
          </div>
          <div class="text-right">
            <div class="font-bold text-white">${log.to}</div>
            <span class="text-[10px] text-emerald-400">&check; ${log.status}</span>
          </div>
        </div>
      `).join('');
    }

    function reconcileDrawerModal() {
      playChime();
      alert(`OmniForex End-Of-Day Reconciliation Summary:\n----------------------------------------\nCounter ID: 0${currentCounterId}\nTray ID: #D-12\nAudit Parity: 100% Balanced\nDiscrepancies: £0.00\nSystem Ready for Handover Sign-off.`);
    }

    /* =====================================================================
       9. CURRENCY SELECTION MODAL
       ===================================================================== */
    function toggleCurrencyDropdown(target) {
      activeCurrencyPickerTarget = target;
      document.getElementById('currencySearchInput').value = '';
      filterCurrencies('');
      document.getElementById('currencyModal').classList.remove('hidden');
    }

    function closeCurrencyModal() {
      document.getElementById('currencyModal').classList.add('hidden');
    }

    function filterCurrencies(search) {
      const term = search.toLowerCase();
      const container = document.getElementById('currencyListContainer');
      const filtered = Object.keys(CURRENCIES).filter(code => {
        const c = CURRENCIES[code];
        return code.toLowerCase().includes(term) || c.name.toLowerCase().includes(term);
      });

      container.innerHTML = filtered.map(code => {
        const c = CURRENCIES[code];
        return `
          <button 
            type="button" 
            onclick="selectCurrencyOption('${code}')" 
            class="w-full flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-800 transition-colors text-left"
          >
            <div class="flex items-center gap-3">
              <span class="text-2xl">${c.flag}</span>
              <div>
                <strong class="text-white block">${code}</strong>
                <span class="text-slate-400 text-[11px]">${c.name}</span>
              </div>
            </div>
            <div class="text-right">
              <span class="text-emerald-400 font-bold block">${c.symbol}${c.inStock.toLocaleString()}</span>
              <span class="text-[10px] text-slate-500 font-mono">In Stock</span>
            </div>
          </button>
        `;
      }).join('');
    }

    function selectCurrencyOption(code) {
      if (activeCurrencyPickerTarget === 'from') {
        selectedFromCode = code;
      } else {
        selectedToCode = code;
      }
      closeCurrencyModal();
      updateCurrencyPickersUI();
      recalculateExchange();
      setChartPair(code === 'GBP' ? selectedFromCode : code);
    }

    /* =====================================================================
       10. HISTORICAL FX CANVAS CHART RENDERER
       ===================================================================== */
    let chartCanvas, chartCtx;

    function initChartCanvas() {
      chartCanvas = document.getElementById('fxRateChartCanvas');
      chartCtx = chartCanvas.getContext('2d');
      renderChart();
      window.addEventListener('resize', renderChart);
    }

    function setChartPair(code) {
      currentChartCurrency = code;
      document.getElementById('chartPairTitle').innerText = `${code} / GBP`;
      renderChart();
    }

    function renderChart() {
      if (!chartCanvas || !chartCtx) return;

      const rect = chartCanvas.parentElement.getBoundingClientRect();
      chartCanvas.width = rect.width * window.devicePixelRatio;
      chartCanvas.height = rect.height * window.devicePixelRatio;
      chartCtx.scale(window.devicePixelRatio, window.devicePixelRatio);

      const w = rect.width;
      const h = rect.height;

      // Mock 7-day points seeded around current mid-rate
      const curr = CURRENCIES[currentChartCurrency] || CURRENCIES['USD'];
      const currentRate = 1 / curr.midPerGbp;

      const points = [
        currentRate * 0.985,
        currentRate * 0.991,
        currentRate * 0.988,
        currentRate * 0.995,
        currentRate * 0.992,
        currentRate * 0.998,
        currentRate
      ];

      const minVal = Math.min(...points) * 0.995;
      const maxVal = Math.max(...points) * 1.005;

      chartCtx.clearRect(0, 0, w, h);

      // Draw Grid Lines
      chartCtx.strokeStyle = 'rgba(51, 65, 85, 0.4)';
      chartCtx.lineWidth = 1;
      for (let i = 1; i <= 3; i++) {
        const y = (h / 4) * i;
        chartCtx.beginPath();
        chartCtx.moveTo(0, y);
        chartCtx.lineTo(w, y);
        chartCtx.stroke();
      }

      // Coordinates
      const stepX = w / (points.length - 1);
      const coords = points.map((p, idx) => {
        const x = idx * stepX;
        const y = h - ((p - minVal) / (maxVal - minVal)) * (h - 24) - 12;
        return { x, y, val: p };
      });

      // Fill Gradient Area
      const grad = chartCtx.createLinearGradient(0, 0, 0, h);
      grad.addColorStop(0, 'rgba(16, 185, 129, 0.35)');
      grad.addColorStop(1, 'rgba(16, 185, 129, 0.0)');

      chartCtx.beginPath();
      chartCtx.moveTo(coords[0].x, coords[0].y);
      for (let i = 1; i < coords.length; i++) {
        chartCtx.lineTo(coords[i].x, coords[i].y);
      }
      chartCtx.lineTo(w, h);
      chartCtx.lineTo(0, h);
      chartCtx.closePath();
      chartCtx.fillStyle = grad;
      chartCtx.fill();

      // Stroke Path
      chartCtx.beginPath();
      chartCtx.moveTo(coords[0].x, coords[0].y);
      for (let i = 1; i < coords.length; i++) {
        chartCtx.lineTo(coords[i].x, coords[i].y);
      }
      chartCtx.strokeStyle = '#10b981';
      chartCtx.lineWidth = 2.5;
      chartCtx.stroke();

      // Draw active spot node
      const last = coords[coords.length - 1];
      chartCtx.beginPath();
      chartCtx.arc(last.x - 3, last.y, 4.5, 0, Math.PI * 2);
      chartCtx.fillStyle = '#00ff66';
      chartCtx.fill();
      chartCtx.strokeStyle = '#090d16';
      chartCtx.lineWidth = 2;
      chartCtx.stroke();
    }

    /* =====================================================================
       11. REAL-TIME SPOT MARKET JITTER SIMULATOR
       ===================================================================== */
    function simulateMarketJitter() {
      // Pick a random currency and introduce micro tick
      const keys = ['USD', 'EUR', 'JPY', 'AED', 'CAD'];
      const chosen = keys[Math.floor(Math.random() * keys.length)];
      const delta = (Math.random() - 0.5) * 0.0012;

      CURRENCIES[chosen].midPerGbp = Math.max(0.1, CURRENCIES[chosen].midPerGbp + delta);

      renderRatesTable();
      if (selectedFromCode === chosen || selectedToCode === chosen) {
        recalculateExchange();
      }
    }
  </script>
