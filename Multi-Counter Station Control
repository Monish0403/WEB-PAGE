      const keys = Object.keys(CURRENCIES).filter(k => k !== 'GBP');
      tbody.innerHTML = keys.map(code => {
        const item = CURRENCIES[code];
        // 1 Foreign in terms of GBP:
        const midInGbp = 1 / item.midPerGbp;
        
        // We Buy Foreign: We pay less GBP for 1 unit of foreign
        const weBuyGbp = midInGbp * (1 - margin);
        // We Sell Foreign: Customer pays more GBP for 1 unit of foreign
        const weSellGbp = midInGbp * (1 + margin);
        const spreadPct = (margin * 2 * 100).toFixed(2);

        return `
          <tr class="hover:bg-slate-800/40 transition-colors cursor-pointer" onclick="quickSelectCurrency('${code}')">
            <td class="py-2.5 font-bold text-white flex items-center gap-2">
              <span class="text-base">${item.flag}</span>
              <div>
