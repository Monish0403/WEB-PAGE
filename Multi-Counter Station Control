      playChime();

      // Deduct from Stock
      const fromObj = CURRENCIES[selectedFromCode];
      const toObj = CURRENCIES[selectedToCode];
      const outAmount = parseFloat(document.getElementById('outputToAmount').innerText.replace(/,/g, ''));

      fromObj.inStock += inputAmount;
      toObj.inStock = Math.max(0, toObj.inStock - outAmount);

      // Create Deal Ref ID
      const dealRef = `FX-${new Date().getFullYear()}-${Math.floor(100000 + Math.random() * 900000)}`;
      const now = new Date();
      const timestampStr = now.toISOString().replace('T', ' ').slice(0, 19) + ' BST';

      // Populate Receipt Modal
      document.getElementById('rcptDealRef').innerText = dealRef;
      document.getElementById('rcptTimestamp').innerText = timestampStr;
      document.getElementById('rcptDeskName').innerText = COUNTERS.find(c => c.id === currentCounterId).title;
      document.getElementById('rcptOperation').innerText = tradeDirection === 'BUY' ? 'WE BUY (CUSTOMER CONVERTS FOREIGN)' : 'WE SELL (CUSTOMER PURCHASES FOREIGN)';
      document.getElementById('rcptTender').innerText = `${fromObj.symbol}${inputAmount.toLocaleString()} ${selectedFromCode}`;
      document.getElementById('rcptRate').innerText = document.getElementById('appliedRateLabel').innerText.split('=')[1].trim();
      document.getElementById('rcptPayout').innerText = `${toObj.symbol}${outAmount.toLocaleString()} ${selectedToCode}`;
      
      document.getElementById('rcptCustName').innerText = custName;
      document.getElementById('rcptCustId').innerText = custId;
      document.getElementById('rcptCustNat').innerText = document.getElementById('custNat').value;
      document.getElementById('rcptCustPurpose').innerText = document.getElementById('custPurpose').value;

      // Append to Audit Log
      auditLogs.unshift({
        id: dealRef,
        time: now.toTimeString().slice(0, 5),
        counter: currentCounterId,
        type: tradeDirection,
        from: `${fromObj.symbol}${inputAmount.toFixed(0)} ${selectedFromCode}`,
        to: `${toObj.symbol}${outAmount.toFixed(0)} ${selectedToCode}`,
        status: 'Completed',
        cust: custName
      });

      renderAuditLog();
      renderDrawerBalances();
      updateCurrencyPickersUI();

      // Open Modal
      document.getElementById('receiptModal').classList.remove('hidden');
      managerOverrideApproved = false;
    }

