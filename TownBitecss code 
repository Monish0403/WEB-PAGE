/* ============================================================
   TownBite – stylesheet
   Palette: warm saffron + deep green on cream
   ============================================================ */

:root {
  --saffron: #f26a1b;
  --saffron-dark: #d4550c;
  --green: #14532d;
  --green-soft: #1f7a47;
  --cream: #fff8ee;
  --cream-2: #fdeedb;
  --ink: #1d1b19;
  --muted: #5f5a54;
  --white: #ffffff;
  --radius: 16px;
  --shadow: 0 10px 30px rgba(60, 30, 0, 0.10);
  --font: "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
}
0h1, h2, h3, h4  --muted: #5f5a54;
  --white: #ffffff;
  --radius: 16px;
  --shadow: 0 10px 30px rgba(60, 30, 0, 0.10);
  --font: "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
}

*, *::before, *::after { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  font-family: var(--font);
  color: var(--ink);
  background: var(--cream);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }

.container { width: min(1120px, 92%); margin-inline: auto; }
.narrow { width: min(720px, 92%); }

h1, h2, h3, h4 { line-height: 1.2; margin: 0 0 .5em; }
h1 { font-size: clamp(2.2rem, 5.5vw, 3.8rem); letter-spacing: -0.02em; }
h2 { font-size: clamp(1.7rem, 3.5vw, 2.4rem); letter-spacing: -0.01em; }
h3 { font-size: 1.15rem; }
p { margin: 0 0 1em; }

/* ---------- Buttons ---------- */
.btn {
  display: inline-block;
  background: var(--saffron);
  color: var(--white);
  font-weight: 700;
  padding: 14px 26px;
  border: 2px solid var(--saffron);
  border-radius: 999px;
  cursor: pointer;
  font-size: 1rem;
  font-family: inherit;
  transition: background .2s, transform .2s, color .2s;
}
.btn:hover { background: var(--saffron-dark); border-color: var(--saffron-dark); transform: translateY(-2px); }
.btn-outline { background: transparent; color: var(--green); border-color: var(--green); }
.btn-outline:hover { background: var(--green); border-color: var(--green); color: var(--white); }
.btn-small { padding: 9px 18px; font-size: .95rem; }
.btn-block { width: 100%; }

/* ---------- Navigation ---------- */
.nav {
  position: sticky; top: 0; z-index: 50;
  background: rgba(255, 248, 238, .94);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid rgba(0,0,0,.06);
}
.nav-inner { display: flex; align-items: center; justify-content: space-between; height: 68px; }
.logo { font-size: 1.6rem; font-weight: 800; color: var(--green); letter-spacing: -0.02em; }
.logo span { color: var(--saffron); }
.logo.light { color: var(--white); }
.menu { display: flex; align-items: center; gap: 26px; font-weight: 600; }
.menu a:not(.btn):hover { color: var(--saffron); }

.menu-toggle { display: none; }
.menu-icon { display: none; cursor: pointer; padding: 10px; }
.menu-icon span, .menu-icon span::before, .menu-icon span::after {
  content: ""; display: block; width: 24px; height: 3px; background: var(--green);
  border-radius: 2px; position: relative; transition: .25s;
}
.menu-icon span::before { position: absolute; top: -8px; }
.menu-icon span::after { position: absolute; top: 8px; }

/* ---------- Hero ---------- */
.hero {
  padding: 70px 0 80px;
  background:
    radial-gradient(circle at 85% 15%, rgba(242,106,27,.18), transparent 45%),
    radial-gradient(circle at 5% 90%, rgba(31,122,71,.14), transparent 40%),
    var(--cream);
}
.hero-grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: 50px; align-items: center; }
.eyebrow {
  display: inline-block; background: var(--cream-2); color: var(--saffron-dark);
  font-weight: 700; font-size: .85rem; padding: 6px 14px; border-radius: 999px;
  text-transform: uppercase; letter-spacing: .06em;
}
.hero h1 em { font-style: normal; color: var(--saffron); }
.lead { font-size: 1.15rem; color: var(--muted); max-width: 540px; }
.hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin: 28px 0; }
.hero-stats { list-style: none; padding: 0; margin: 0; display: flex; gap: 28px; flex-wrap: wrap; color: var(--muted); font-size: .92rem; }
.hero-stats strong { display: block; font-size: 1.6rem; color: var(--green); }

.order-card {
  background: var(--white); border-radius: 22px; padding: 28px;
  box-shadow: var(--shadow); transform: rotate(2deg);
}
.oc-title { font-weight: 700; margin-bottom: 14px; }
.oc-bar { height: 10px; background: #eee; border-radius: 999px; overflow: hidden; margin-bottom: 18px; }
.oc-fill { width: 68%; height: 100%; background: linear-gradient(90deg, var(--saffron), #ffa05c); border-radius: 999px; }
.oc-steps { list-style: none; padding: 0; margin: 0 0 16px; }
.oc-steps li { padding: 6px 0 6px 28px; position: relative; color: #9a948d; }
.oc-steps li::before {
  content: ""; position: absolute; left: 0; top: 11px; width: 14px; height: 14px;
  border-radius: 50%; border: 2px solid #ccc; background: var(--white);
}
.oc-steps li.done { color: var(--ink); }
.oc-steps li.done::before { background: var(--green-soft); border-color: var(--green-soft); }
.oc-steps li.active { color: var(--saffron-dark); font-weight: 700; }
.oc-steps li.active::before { border-color: var(--saffron); background: var(--saffron); }
.oc-eta { margin: 0; color: var(--muted); }
.oc-eta strong { color: var(--green); }

/* ---------- Sections ---------- */
.section { padding: 80px 0; }
.section.alt { background: var(--cream-2); }
.section.dark { background: var(--green); color: var(--white); }
.section h2 { text-align: center; }
.section-sub { text-align: center; color: var(--muted); max-width: 560px; margin: 0 auto 44px; }
.section-sub.left { text-align: left; margin-left: 0; }
.section-sub.light { color: rgba(255,255,255,.8); }

.grid { display: grid; gap: 22px; }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-4 { grid-template-columns: repeat(4, 1fr); }
.grid-6 { grid-template-columns: repeat(3, 1fr); }

.card {
  background: var(--white); border-radius: var(--radius); padding: 28px;
  box-shadow: var(--shadow); transition: transform .2s;
}
a.card:hover { transform: translateY(-5px); }
.step .num {
  display: inline-grid; place-items: center; width: 40px; height: 40px;
  border-radius: 50%; background: var(--saffron); color: var(--white);
  font-weight: 800; margin-bottom: 14px;
}
.step p, .cat p { color: var(--muted); margin: 0; }
.cat { text-align: center; }
.cat .emoji { font-size: 2.4rem; display: block; margin-bottom: 8px; }

.two-col { display: grid; grid-template-columns: 1fr 1.2fr; gap: 50px; align-items: start; }
.two-col h2 { text-align: left; }

.feature-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
.feature-list li {
  background: var(--white); border-left: 5px solid var(--saffron);
  padding: 16px 20px; border-radius: 10px; box-shadow: var(--shadow);
}

/* dark cards */
.dark-card { background: rgba(255,255,255,.08); box-shadow: none; border: 1px solid rgba(255,255,255,.15); }
.dark-card p { color: rgba(255,255,255,.8); margin: 0; }

/* ---------- Forms ---------- */
.form {
  background: var(--white); color: var(--ink); border-radius: var(--radius);
  padding: 30px; box-shadow: var(--shadow); display: grid; gap: 16px;
}
.form-inline { margin-top: 40px; }
.form h3 { margin: 0; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
label { display: grid; gap: 6px; font-weight: 600; font-size: .92rem; }
input, select, textarea {
  font: inherit; padding: 12px 14px; border: 1.5px solid #ddd5ca; border-radius: 10px;
  background: #fffdfa; color: var(--ink);
}
input:focus, select:focus, textarea:focus {
  outline: none; border-color: var(--saffron); box-shadow: 0 0 0 3px rgba(242,106,27,.2);
}

/* ---------- FAQ ---------- */
.faq {
  background: var(--white); border-radius: 12px; padding: 18px 22px;
  margin-bottom: 12px; box-shadow: var(--shadow);
}
.faq summary { cursor: pointer; font-weight: 700; list-style: none; position: relative; padding-right: 28px; }
.faq summary::-webkit-details-marker { display: none; }
.faq summary::after { content: "+"; position: absolute; right: 0; color: var(--saffron); font-size: 1.4rem; line-height: 1; }
.faq[open] summary::after { content: "–"; }
.faq p { margin: 12px 0 0; color: var(--muted); }

/* ---------- Footer ---------- */
.footer { background: #0e2a1a; color: rgba(255,255,255,.8); padding: 56px 0 24px; }
.footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 30px; }
.footer h4 { color: var(--white); margin-bottom: 12px; }
.footer a:not(.logo) { display: block; margin-bottom: 8px; }
.footer a:not(.logo):hover { color: var(--saffron); }
.footer p { margin: 0 0 8px; }
.copy { text-align: center; margin-top: 40px !important; font-size: .85rem; opacity: .7; }

/* ---------- Responsive ---------- */
@media (max-width: 900px) {
  .hero-grid, .two-col { grid-template-columns: 1fr; }
  .hero-card { max-width: 420px; }
  .grid-4 { grid-template-columns: repeat(2, 1fr); }
  .grid-3 { grid-template-columns: 1fr; }
  .footer-grid { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 760px) {
  .menu-icon { display: block; }
  .menu {
    position: absolute; top: 68px; left: 0; right: 0;
    background: var(--cream); flex-direction: column; align-items: flex-start;
    gap: 0; padding: 8px 4%; border-bottom: 1px solid rgba(0,0,0,.08);
    max-height: 0; overflow: hidden; transition: max-height .3s;
  }
  .menu a { padding: 12px 0; width: 100%; }
  .menu .btn { text-align: center; margin: 8px 0 14px; }
  .menu-toggle:checked ~ .menu { max-height: 420px; }
}

@media (max-width: 560px) {
  .section { padding: 56px 0; }
  .hero { padding: 44px 0 56px; }
  .grid-4, .grid-6 { grid-template-columns: 1fr 1fr; }
  .form-row { grid-template-columns: 1fr; }
  .card { padding: 20px; }
  .order-card { transform: none; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  * { transition: none !important; }
}
