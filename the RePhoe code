      msgs.innerHTML += `
        <div class="flex items-end justify-end gap-2">
          <div class="bg-brand-600 text-white p-2.5 rounded-2xl rounded-tr-none shadow-xs max-w-[80%]">
            ${val}
          </div>
        </div>
      `;
      input.value = '';
      msgs.scrollTop = msgs.scrollHeight;

      // Simulated auto-reply
      setTimeout(() => {
        msgs.innerHTML += `
          <div class="flex items-start gap-2">
            <div class="w-6 h-6 rounded-full bg-slate-800 text-white flex items-center justify-center text-[10px] shrink-0 font-bold">
              ${selectedPhoneForModal ? selectedPhoneForModal.sellerName.charAt(0) : 'S'}
            </div>
            <div class="bg-white p-2.5 rounded-2xl rounded-tl-none border border-slate-200 text-slate-700 shadow-xs max-w-[80%]">
              Understood! We can arrange express delivery or you can inspect it in person. Feel free to use 'Buy Now' to lock this device with full 7-day buyer return protection.
            </div>
          </div>
        `;
        msgs.scrollTop = msgs.scrollHeight;
      }, 1000);
    }

    function simulateBuyNow() {
      if (!selectedPhoneForModal) return;
      closeProductModal();
      showToast(`Reserved ${selectedPhoneForModal.model}! Redirecting to RePhone Secure Escrow Checkout...`);
    }

    /* ==========================================================
       SELL YOUR PHONE & RESALE APPRAISAL ENGINE
       ========================================================== */
    function openSellModal() {
      document.getElementById('sellModal').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      updateEstimatedPrice();
    }

    function closeSellModal() {
      document.getElementById('sellModal').classList.add('hidden');
      document.body.style.overflow = 'auto';
    }

    function previewSellImage(url) {
      document.getElementById('sellImagePreview').src = url;
    }

    function triggerQuickEstimate() {
      const brand = document.getElementById('heroQuickBrand').value;
      const model = document.getElementById('heroQuickModel').value;
      
      openSellModal();
      document.getElementById('sellBrand').value = brand;
      document.getElementById('sellModel').value = model;
      updateEstimatedPrice();
    }

    // Dynamic valuation algorithm based on hardware conditions
    function updateEstimatedPrice() {
      const brand = document.getElementById('sellBrand').value;
      const model = document.getElementById('sellModel').value.toLowerCase();
      const storage = document.getElementById('sellStorage').value;
      const condition = document.getElementById('sellCondition').value;
      const battery = parseInt(document.getElementById('sellBatteryRange').value) || 85;

      let basePrice = 28000;

      if (brand === 'Apple') {
        basePrice = 42000;
        if (model.includes('15') || model.includes('pro')) basePrice += 22000;
        if (model.includes('14')) basePrice += 12000;
      } else if (brand === 'Samsung') {
        basePrice = 30000;
        if (model.includes('ultra') || model.includes('s23') || model.includes('s24')) basePrice += 20000;
        if (model.includes('flip') || model.includes('fold')) basePrice += 15000;
      } else if (brand === 'Google') {
        basePrice = 26000;
        if (model.includes('8') || model.includes('pro')) basePrice += 18000;
      }

      // Storage modifier
      if (storage === '256GB') basePrice *= 1.12;
      if (storage === '512GB') basePrice *= 1.25;
      if (storage === '1TB') basePrice *= 1.35;

      // Condition modifier
      if (condition === 'Flawless') basePrice *= 1.15;
      if (condition === 'Fair') basePrice *= 0.85;

      // Battery health factor
      const batteryFactor = 0.75 + (battery / 400); // 80% = 0.95, 100% = 1.0
      basePrice = Math.round((basePrice * batteryFactor) / 500) * 500;

      document.getElementById('suggestedPriceTag').innerText = `₹${basePrice.toLocaleString('en-IN')}`;
    }

    function useSuggestedPrice() {
      const rawText = document.getElementById('suggestedPriceTag').innerText;
      const cleanNum = rawText.replace(/[^0-9]/g, '');
      document.getElementById('sellPrice').value = cleanNum;
      showToast('Applied recommended fair market valuation to your listing!');
    }

    function handleSellSubmit(e) {
      e.preventDefault();

      const brand = document.getElementById('sellBrand').value;
      const model = document.getElementById('sellModel').value;
      const storage = document.getElementById('sellStorage').value;
      const condition = document.getElementById('sellCondition').value;
      const batteryHealth = parseInt(document.getElementById('sellBatteryRange').value);
      const price = parseInt(document.getElementById('sellPrice').value);
      const city = document.getElementById('sellCity').value;
      const phoneContact = document.getElementById('sellPhoneContact').value;
      const image = document.getElementById('sellPresetImage').value;

      const boxItems = [];
      if (document.getElementById('accOriginalBox').checked) boxItems.push('Original Box');
      if (document.getElementById('accOriginalCharger').checked) boxItems.push('Fast Charger');
      if (document.getElementById('accOriginalBill').checked) boxItems.push('GST Tax Invoice');
      if (document.getElementById('accCase').checked) boxItems.push('Protective Case');

      const newPhone = {
        id: 'phone-user-' + Date.now(),
        brand,
        model,
        storage,
        condition,
        conditionScore: condition === 'Flawless' ? '9.8/10' : condition === 'Excellent' ? '9.1/10' : '8.5/10',
        batteryHealth,
        price,
        originalPrice: Math.round(price * 1.5 / 1000) * 1000,
        warranty: 'RePhone Peer Verified',
        location: city,
        sellerType: 'Individual Seller',
        sellerName: 'Verified Member (' + phoneContact.slice(-4) + ')',
        sellerRating: 5.0,
        verified: true, // auto-verified for demonstration
        dateAdded: 'Just now',
        images: [image],
        boxItems
      };

      // Add to beginning of array
      phonesData.unshift(newPhone);
      savePhonesToStorage();
      applyFilters();
      closeSellModal();

      // Reset form
      document.getElementById('sellPhoneForm').reset();
      updateEstimatedPrice();

      showToast(`Success! Your ${model} has been listed to buyers!`);
      
      // Auto scroll to card
      document.getElementById('phonesGrid').scrollIntoView({ behavior: 'smooth' });
    }

    /* ==========================================================
       WISHLIST MANAGEMENT & DRAWER
       ========================================================== */
    function toggleWishlist(phoneId) {
      const index = wishlistIds.indexOf(phoneId);
      if (index > -1) {
        wishlistIds.splice(index, 1);
        showToast('Removed device from saved wishlist');
      } else {
        wishlistIds.push(phoneId);
        showToast('Saved to your wishlist!');
      }
      saveWishlistToStorage();
      applyFilters();
      renderWishlistDrawerItems();
    }

    function updateWishlistBadges() {
      const badge = document.getElementById('wishlistCountBadge');
      const drawerCount = document.getElementById('wishlistDrawerCount');
      const count = wishlistIds.length;

      drawerCount.innerText = count;
      if (count > 0) {
        badge.innerText = count;
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    }

    function toggleWishlistDrawer() {
      const drawer = document.getElementById('wishlistDrawer');
      const isOpen = !drawer.classList.contains('translate-x-full');
      if (isOpen) {
        drawer.classList.add('translate-x-full');
      } else {
        renderWishlistDrawerItems();
        drawer.classList.remove('translate-x-full');
      }
    }

    function renderWishlistDrawerItems() {
      const container = document.getElementById('wishlistItemsContainer');
      const savedPhones = phonesData.filter(p => wishlistIds.includes(p.id));

      if (savedPhones.length === 0) {
        container.innerHTML = `
          <div class="py-12 text-center text-slate-400">
            <i class="ph ph-heart-break text-3xl mb-2"></i>
            <p class="text-xs">No saved devices yet.<br/>Click the heart icon on any phone card to bookmark it.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = savedPhones.map(p => `
        <div class="py-3 flex items-center justify-between gap-3">
          <div class="w-12 h-12 bg-slate-100 rounded-xl overflow-hidden shrink-0">
            <img src="${p.images[0]}" class="w-full h-full object-contain mix-blend-multiply">
          </div>
          <div class="flex-1 min-w-0 cursor-pointer" onclick="toggleWishlistDrawer(); openProductModal('${p.id}')">
            <h5 class="text-xs font-bold text-slate-900 truncate">${p.model}</h5>
            <p class="text-[11px] text-slate-500">${p.storage} &bull; ${p.batteryHealth}% Battery</p>
            <p class="text-xs font-extrabold text-brand-700">₹${p.price.toLocaleString('en-IN')}</p>
          </div>
          <button onclick="toggleWishlist('${p.id}')" class="text-slate-400 hover:text-rose-500 p-1">
            <i class="ph-bold ph-trash text-sm"></i>
          </button>
        </div>
      `).join('');
    }

    function clearAllWishlist() {
      wishlistIds = [];
      saveWishlistToStorage();
      renderWishlistDrawerItems();
      applyFilters();
      showToast('Wishlist cleared');
    }

    /* ==========================================================
       SEARCH & CITY FILTER HANDLERS
       ========================================================== */
    function handleSearch(val) {
      searchQuery = val;
      const clearBtn = document.getElementById('clearSearchBtn');
      if (val.trim() !== '') {
        clearBtn.classList.remove('hidden');
      } else {
        clearBtn.classList.add('hidden');
      }
      applyFilters();
    }

    function clearSearch() {
      searchQuery = '';
      document.getElementById('globalSearchInput').value = '';
      document.getElementById('mobileSearchInput').value = '';
      document.getElementById('clearSearchBtn').classList.add('hidden');
      applyFilters();
    }

    function handleCityFilter(city) {
      activeCityFilter = city;
      document.getElementById('cityFilterSelect').value = city;
      applyFilters();
    }

    function resetAllFilters() {
      activeBrandFilter = 'All';
      activeCityFilter = 'All';
      searchQuery = '';
      document.getElementById('globalSearchInput').value = '';
      document.getElementById('mobileSearchInput').value = '';
      document.getElementById('cityFilterSelect').value = 'All';
      document.getElementById('verifiedOnlyToggle').checked = false;
      document.getElementById('conditionFilterSelect').value = 'All';
      document.getElementById('storageFilterSelect').value = 'All';
      document.getElementById('sortSelect').value = 'featured';
      renderBrandTabs();
      applyFilters();
      showToast('Filters cleared');
    }

    /* ==========================================================
       TOAST NOTIFICATION COMPONENT
       ========================================================== */
    function showToast(message) {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      toast.className = 'bg-slate-900 text-white text-xs font-bold px-4 py-3 rounded-2xl shadow-xl flex items-center gap-2 transform transition-all duration-300 translate-y-3 opacity-0 pointer-events-auto border border-slate-700';
      toast.innerHTML = `
        <i class="ph-bold ph-info text-brand-400 text-base"></i>
        <span>${message}</span>
      `;
      container.appendChild(toast);

      setTimeout(() => {
        toast.classList.remove('translate-y-3', 'opacity-0');
      }, 10);

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-3');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    // Initialize application on load
    window.addEventListener('DOMContentLoaded', initApp);
  </script>
</body>
</html>
