    function closeOfferModal() {
      document.getElementById('offerModal').classList.add('hidden');
    }

    function quickOfferPercent(perc) {
      if (!selectedPhoneForModal) return;
      const target = selectedPhoneForModal.price * (1 + (perc / 100));
      document.getElementById('counterOfferInput').value = Math.round(target / 100) * 100;
    }

    function submitCounterOffer() {
      const offer = document.getElementById('counterOfferInput').value;
      if (!offer || offer <= 0) {
        showToast('Please enter a valid offer amount');
