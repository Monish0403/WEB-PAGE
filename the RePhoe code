    /* ==========================================================
       APP STATE MANAGEMENT
       ========================================================== */
    let phonesData = [];
    let activeBrandFilter = 'All';
    let activeCityFilter = 'All';
    let searchQuery = '';
    let selectedPhoneForModal = null;
    let wishlistIds = [];

    // Initialize application data
    function initApp() {
      // Load saved devices or fallback to defaults
      const localPhones = localStorage.getItem('rephone_listings');
      if (localPhones) {
        try {
          phonesData = JSON.parse(localPhones);
        } catch (e) {
          phonesData = [...DEFAULT_PHONES];
        }
      } else {
        phonesData = [...DEFAULT_PHONES];
        savePhonesToStorage();
      }

      // Load Wishlist
      const localWishlist = localStorage.getItem('rephone_wishlist');
      if (localWishlist) {
        try {
          wishlistIds = JSON.parse(localWishlist);
        } catch (e) {
          wishlistIds = [];
        }
      }

      renderBrandTabs();
      updateWishlistBadges();
      applyFilters();
      updateEstimatedPrice();
    }

    function savePhonesToStorage() {
      localStorage.setItem('rephone_listings', JSON.stringify(phonesData));
    }

    function saveWishlistToStorage() {
      localStorage.setItem('rephone_wishlist', JSON.stringify(wishlistIds));
      updateWishlistBadges();
    }

    /* ==========================================================
       RENDERING: BRAND TABS
       ========================================================== */
    const BRANDS = ['All', 'Apple', 'Samsung', 'Google', 'OnePlus', 'Nothing', 'Xiaomi'];

    function renderBrandTabs() {
      const container = document.getElementById('brandTabsContainer');
      container.innerHTML = BRANDS.map(brand => {
        const isActive = activeBrandFilter === brand;
        return `
          <button 
            onclick="setBrandFilter('${brand}')"
            class="px-4 py-2 rounded-xl text-xs font-bold shrink-0 transition-all flex items-center gap-1.5 ${
              isActive 
                ? 'bg-slate-900 text-white shadow-md' 
                : 'bg-slate-100 text-slate-600 hover:bg-slate-200 hover:text-slate-900'
            }"
          >
            ${getBrandIcon(brand)}
            <span>${brand === 'All' ? 'All Brands' : brand}</span>
          </button>
        `;
      }).join('');
    }

    function getBrandIcon(brand) {
      switch (brand) {
        case 'Apple': return '<i class="ph-bold ph-apple-logo text-sm"></i>';
        case 'Samsung': return '<i class="ph-bold ph-android-logo text-sm"></i>';
        case 'Google': return '<i class="ph-bold ph-google-logo text-sm"></i>';
        case 'OnePlus': return '<i class="ph-bold ph-lightning text-sm"></i>';
        default: return '<i class="ph-bold ph-device-mobile text-sm"></i>';
      }
    }

    function setBrandFilter(brand) {
      activeBrandFilter = brand;
      renderBrandTabs();
      applyFilters();
      
      // Auto scroll smoothly to listings
      document.getElementById('phonesGrid').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    /* ==========================================================
       FILTERING & SORTING LOGIC
       ========================================================== */
    function applyFilters() {
      const certifiedOnly = document.getElementById('verifiedOnlyToggle').checked;
      const conditionSelect = document.getElementById('conditionFilterSelect').value;
      const storageSelect = document.getElementById('storageFilterSelect').value;
      const sortSelect = document.getElementById('sortSelect').value;

      let filtered = phonesData.filter(phone => {
        // Brand Filter
        if (activeBrandFilter !== 'All' && phone.brand.toLowerCase() !== activeBrandFilter.toLowerCase()) {
          return false;
        }
        // City Filter
        if (activeCityFilter !== 'All' && phone.location !== activeCityFilter) {
          return false;
        }
        // Certified / Verified Toggle
        if (certifiedOnly && !phone.verified) {
          return false;
        }
        // Condition Filter
        if (conditionSelect !== 'All' && phone.condition !== conditionSelect) {
          return false;
        }
        // Storage Filter
        if (storageSelect !== 'All') {
          if (storageSelect === '512GB+' && !(phone.storage.includes('512') || phone.storage.includes('1TB'))) {
            return false;
          } else if (storageSelect !== '512GB+' && !phone.storage.includes(storageSelect.replace('GB', ''))) {
            return false;
          }
        }
        // Search Query
        if (searchQuery.trim() !== '') {
          const q = searchQuery.toLowerCase();
          const matchTitle = phone.model.toLowerCase().includes(q);
          const matchBrand = phone.brand.toLowerCase().includes(q);
          const matchStorage = phone.storage.toLowerCase().includes(q);
          const matchLoc = phone.location.toLowerCase().includes(q);
          if (!matchTitle && !matchBrand && !matchStorage && !matchLoc) {
            return false;
          }
        }

        return true;
      });

      // Sorting
      if (sortSelect === 'price-asc') {
        filtered.sort((a, b) => a.price - b.price);
      } else if (sortSelect === 'price-desc') {
        filtered.sort((a, b) => b.price - a.price);
      } else if (sortSelect === 'battery-desc') {
        filtered.sort((a, b) => b.batteryHealth - a.batteryHealth);
      } else if (sortSelect === 'newest') {
        filtered.reverse();
      }

      renderPhonesGrid(filtered);
      renderActiveTags();
    }

