      if (!selectedPhoneForModal) return;
      document.getElementById('offerListingPrice').innerText = `₹${selectedPhoneForModal.price.toLocaleString('en-IN')}`;
      document.getElementById('counterOfferInput').value = Math.round(selectedPhoneForModal.price * 0.95 / 500) * 500;
