<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RePhone | Buy & Sell Certified Pre-Owned Smartphones</title>

  <!-- Google Font: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Phosphor Icons -->
  <script src="https://unpkg.com/@phosphor-icons/web"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'Inter', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#f0fdf4',
              100: '#dcfce7',
              200: '#bbf7d0',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
              900: '#064e3b',
            },
            accent: {
              500: '#3b82f6',
              600: '#2563eb',
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Custom utility & scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
    .badge-shimmer {
      background: linear-gradient(110deg, #10b981 8%, #34d399 18%, #10b981 33%);
      background-size: 200% 100%;
      animation: shimmer 2.5s infinite linear;
    }
    @keyframes shimmer {
      0% { background-position: -200% 0; }
      100% { background-position: 200% 0; }
    }
    .modal-backdrop {
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col selection:bg-brand-500 selection:text-white">

  <!-- ================= TOP ANNOUNCEMENT BAR ================= -->
  <div class="bg-slate-900 text-slate-300 text-xs py-2 px-4 border-b border-slate-800">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1 bg-brand-500/20 text-brand-400 font-semibold px-2 py-0.5 rounded-full text-[11px]">
          <i class="ph-bold ph-shield-check"></i> RePhone Assured
        </span>
        <span class="hidden sm:inline">32-Point Quality Inspection &middot; 7-Day Money Back &middot; Up to 1 Year Warranty</span>
      </div>
      <div class="flex items-center gap-4">
        <span class="flex items-center gap-1"><i class="ph-bold ph-map-pin"></i> Delivering across India</span>
        <a href="#sell-section" onclick="openSellModal()" class="text-brand-400 hover:underline font-medium flex items-center gap-1">
          Sell for Instant Cash <i class="ph-bold ph-arrow-right"></i>
        </a>
      </div>
    </div>
  </div>

  <!-- ================= NAVIGATION HEADER ================= -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-sm transition-all duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
      
      <!-- Brand Logo -->
      <a href="#" class="flex items-center gap-2.5 shrink-0 group">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-brand-600 to-emerald-400 flex items-center justify-center text-white shadow-md shadow-brand-500/25 group-hover:scale-105 transition-transform">
          <i class="ph-fill ph-device-mobile text-2xl"></i>
        </div>
        <div class="flex flex-col">
          <span class="text-2xl font-black tracking-tight text-slate-900 flex items-center gap-0.5">
            Re<span class="text-brand-600">Phone</span>
          </span>
          <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400 -mt-1">Verified Marketplace</span>
        </div>
      </a>

      <!-- Realtime Search Input -->
      <div class="flex-1 max-w-xl mx-2 hidden md:block">
        <div class="relative">
          <i class="ph ph-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-lg"></i>
          <input 
            type="text" 
            id="globalSearchInput"
            placeholder="Search model, brand or specs (e.g. iPhone 14 Pro, Galaxy S23 Ultra, 256GB)..." 
            class="w-full bg-slate-100 hover:bg-slate-100/80 focus:bg-white text-sm pl-11 pr-10 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all placeholder:text-slate-400 font-medium"
            oninput="handleSearch(this.value)"
          />
          <button id="clearSearchBtn" onclick="clearSearch()" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1">
            <i class="ph-bold ph-x text-sm"></i>
          </button>
        </div>
      </div>

      <!-- Action Nav Items -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Wishlist Button -->
        <button onclick="toggleWishlistDrawer()" class="relative p-2.5 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors">
          <i class="ph-bold ph-heart text-2xl"></i>
          <span id="wishlistCountBadge" class="hidden absolute top-1 right-1 w-5 h-5 bg-rose-500 text-white text-[11px] font-bold rounded-full flex items-center justify-center border-2 border-white">0</span>
        </button>

        <!-- Sell Device CTA -->
        <button onclick="openSellModal()" class="flex items-center gap-2 bg-gradient-to-r from-brand-600 to-emerald-600 hover:from-brand-700 hover:to-emerald-700 text-white font-bold px-4 py-2.5 rounded-xl shadow-lg shadow-brand-600/25 transition-all transform hover:-translate-y-0.5 active:translate-y-0">
          <i class="ph-bold ph-plus-circle text-lg"></i>
          <span class="hidden sm:inline">Sell Your Phone</span>
          <span class="sm:hidden">Sell</span>
        </button>

        <!-- Quick Location Selector -->
        <div class="hidden lg:flex items-center gap-1.5 px-3 py-2 bg-slate-100 rounded-xl text-xs font-semibold text-slate-700 border border-slate-200">
          <i class="ph-fill ph-map-pin text-brand-600 text-base"></i>
          <select id="cityFilterSelect" onchange="handleCityFilter(this.value)" class="bg-transparent border-none outline-none cursor-pointer pr-1">
            <option value="All">All Cities</option>
            <option value="Bengaluru">Bengaluru</option>
            <option value="Mumbai">Mumbai</option>
            <option value="Delhi NCR">Delhi NCR</option>
            <option value="Hyderabad">Hyderabad</option>
            <option value="Pune">Pune</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Mobile Search Bar (Only visible on small devices) -->
    <div class="p-3 border-t border-slate-100 md:hidden bg-white">
      <div class="relative">
        <i class="ph ph-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
        <input 
          type="text" 
          id="mobileSearchInput"
          placeholder="Search iPhone, Samsung, Pixel..." 
          class="w-full bg-slate-100 text-sm pl-10 pr-8 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500"
          oninput="handleSearch(this.value)"
        />
      </div>
    </div>
  </header>

  <!-- ================= HERO PROMO BANNER ================= -->
  <section class="bg-gradient-to-b from-slate-900 via-slate-800 to-slate-900 text-white pt-10 pb-12 px-4 relative overflow-hidden">
    <!-- Ambient Glow effects -->
    <div class="absolute -top-32 left-1/4 w-96 h-96 bg-brand-500/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute top-10 right-10 w-80 h-80 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7 space-y-5 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 bg-slate-800/80 border border-slate-700/80 px-3.5 py-1.5 rounded-full text-xs font-semibold text-emerald-400">
          <i class="ph-bold ph-sparkle"></i> India's Cleanest Phone Exchange
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight leading-tight text-white">
          Certified Pre-Owned Flagships. <br class="hidden sm:block" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-blue-400">
            Up to 60% Less Than Retail.
          </span>
        </h1>
        <p class="text-slate-300 text-sm sm:text-base max-w-xl mx-auto lg:mx-0 leading-relaxed font-normal">
          Every phone is passed through our comprehensive 32-point hardware test, IMEI integrity check, and sanitized before delivery.
        </p>

        <!-- Trust Badges Row -->
        <div class="pt-2 flex flex-wrap justify-center lg:justify-start gap-4 sm:gap-6 text-xs text-slate-300 font-medium">
          <div class="flex items-center gap-2 bg-slate-800/50 px-3 py-2 rounded-lg border border-slate-700/60">
            <i class="ph-bold ph-shield-check text-brand-400 text-lg"></i>
            <span>6-12 Mo. Warranty</span>
          </div>
          <div class="flex items-center gap-2 bg-slate-800/50 px-3 py-2 rounded-lg border border-slate-700/60">
            <i class="ph-bold ph-battery-charging text-amber-400 text-lg"></i>
            <span>85%+ Battery Guaranteed</span>
          </div>
          <div class="flex items-center gap-2 bg-slate-800/50 px-3 py-2 rounded-lg border border-slate-700/60">
            <i class="ph-bold ph-arrow-counter-clockwise text-blue-400 text-lg"></i>
            <span>7-Day Return Policy</span>
          </div>
        </div>
      </div>

      <!-- Quick Phone Valuation Teaser Card -->
      <div class="lg:col-span-5">
        <div class="bg-white/10 backdrop-blur-xl border border-white/15 p-6 rounded-2xl shadow-2xl relative">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-white/10">
            <div>
              <p class="text-xs uppercase tracking-wider text-emerald-400 font-bold">Sell in 60 Seconds</p>
              <h2 class="text-lg font-bold text-white">Instant Phone Appraisal</h2>
            </div>
            <div class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold">
              ₹
            </div>
          </div>
          <p class="text-xs text-slate-300 mb-4">Want to upgrade? Get an instant market quote & cash payment at your doorstep.</p>
          
          <div class="grid grid-cols-2 gap-3 mb-4">
            <div>
              <label class="text-[11px] text-slate-300 font-semibold mb-1 block">Brand</label>
              <select id="heroQuickBrand" class="w-full bg-slate-900/80 border border-slate-700 text-white text-xs rounded-xl p-2.5 outline-none focus:border-brand-500">
                <option value="Apple">Apple iPhone</option>
                <option value="Samsung">Samsung Galaxy</option>
                <option value="Google">Google Pixel</option>
                <option value="OnePlus">OnePlus</option>
              </select>
            </div>
            <div>
              <label class="text-[11px] text-slate-300 font-semibold mb-1 block">Model</label>
              <select id="heroQuickModel" class="w-full bg-slate-900/80 border border-slate-700 text-white text-xs rounded-xl p-2.5 outline-none focus:border-brand-500">
                <option value="iPhone 13">iPhone 13 (128GB)</option>
                <option value="iPhone 14">iPhone 14 (128GB)</option>
                <option value="Galaxy S23">Galaxy S23 5G</option>
                <option value="Pixel 7">Pixel 7</option>
              </select>
            </div>
          </div>

          <button onclick="triggerQuickEstimate()" class="w-full py-3 px-4 bg-brand-500 hover:bg-brand-600 text-slate-950 font-bold text-sm rounded-xl transition-colors flex items-center justify-center gap-2 shadow-lg shadow-brand-500/20">
            <span>Calculate Resale Value</span>
            <i class="ph-bold ph-calculator text-base"></i>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= BRAND FILTER TABS ================= -->
  <section class="border-b border-slate-200 bg-white sticky top-20 z-30 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 overflow-x-auto py-3 no-scrollbar scroll-smooth" id="brandTabsContainer">
        <!-- Rendered by JS -->
      </div>
    </div>
  </section>

  <!-- ================= MAIN MARKETPLACE CONTAINER ================= -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full">
    
    <!-- Top toolbar: Stats, Sorting, and Toggle Filters -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
      <div class="flex items-center gap-3">
        <h2 class="text-xl font-extrabold text-slate-900 tracking-tight" id="activeFilterHeading">Available Phones</h2>
        <span id="activeCountBadge" class="bg-slate-100 text-slate-700 text-xs font-bold px-2.5 py-1 rounded-full border border-slate-200">12 devices</span>
      </div>

      <!-- Filters & Sorting Controls -->
      <div class="flex flex-wrap items-center gap-3">
        <!-- Verified Only Toggle -->
        <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold text-slate-700 bg-slate-50 hover:bg-slate-100 border border-slate-200 px-3 py-2 rounded-xl transition-all">
          <input type="checkbox" id="verifiedOnlyToggle" class="accent-brand-600 w-4 h-4 rounded cursor-pointer" onchange="applyFilters()">
          <span class="flex items-center gap-1">
            <i class="ph-bold ph-seal-check text-brand-600"></i>
            <span>Certified Only</span>
          </span>
        </label>

        <!-- Condition Filter Dropdown -->
        <div class="relative">
          <select id="conditionFilterSelect" onchange="applyFilters()" class="bg-slate-50 border border-slate-200 text-slate-700 text-xs font-semibold rounded-xl px-3 py-2 pr-8 focus:outline-none focus:border-brand-500 cursor-pointer">
            <option value="All">All Conditions</option>
            <option value="Flawless">Like New (Mint)</option>
            <option value="Excellent">Good (Light Wear)</option>
            <option value="Fair">Fair (Noticeable)</option>
          </select>
        </div>

        <!-- Storage Filter Dropdown -->
        <div class="relative">
          <select id="storageFilterSelect" onchange="applyFilters()" class="bg-slate-50 border border-slate-200 text-slate-700 text-xs font-semibold rounded-xl px-3 py-2 pr-8 focus:outline-none focus:border-brand-500 cursor-pointer">
            <option value="All">Storage: Any</option>
            <option value="64GB">64 GB</option>
            <option value="128GB">128 GB</option>
            <option value="256GB">256 GB</option>
            <option value="512GB">512 GB+</option>
          </select>
        </div>

        <!-- Sort Select -->
        <div class="relative">
          <select id="sortSelect" onchange="applyFilters()" class="bg-slate-50 border border-slate-200 text-slate-700 text-xs font-semibold rounded-xl px-3 py-2 pr-8 focus:outline-none focus:border-brand-500 cursor-pointer">
            <option value="featured">Sort: Featured</option>
            <option value="price-asc">Price: Low to High</option>
            <option value="price-desc">Price: High to Low</option>
            <option value="battery-desc">Battery Health: Best First</option>
            <option value="newest">Latest Uploads</option>
          </select>
        </div>

        <!-- Reset Filters Button -->
        <button onclick="resetAllFilters()" title="Reset all filters" class="p-2 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-xl transition-colors">
          <i class="ph-bold ph-arrow-counter-clockwise text-base"></i>
        </button>
      </div>
    </div>

    <!-- Active Filter Tags row (appears when filters are active) -->
    <div id="activeTagsRow" class="hidden flex-wrap items-center gap-2 mb-5"></div>

    <!-- PRODUCT LISTINGS GRID -->
    <div id="phonesGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      <!-- Phone cards injected dynamically -->
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden py-16 text-center bg-white rounded-3xl border border-slate-200 p-8">
      <div class="w-20 h-20 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl">
        <i class="ph ph-device-mobile-slash"></i>
      </div>
      <h3 class="text-xl font-bold text-slate-900 mb-2">No matching phones found</h3>
      <p class="text-slate-500 text-sm max-w-md mx-auto mb-6">
        We couldn't find any phone matching your chosen filters. Try widening your price range or clearing selected brands.
      </p>
      <button onclick="resetAllFilters()" class="bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm px-6 py-2.5 rounded-xl transition-all shadow-md">
        Clear All Filters
      </button>
    </div>

  </main>

  <!-- ================= VALUE PROPOSITION / TRUST SECTION ================= -->
  <section class="bg-white border-t border-slate-200 py-12 mt-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-brand-600 font-bold text-xs uppercase tracking-widest">Why Choose RePhone</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">The Safest Way to Buy Used Tech</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 hover:border-slate-200 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-2xl mb-4">
            <i class="ph-bold ph-check-square-offset"></i>
          </div>
          <h3 class="font-bold text-slate-900 mb-1">32-Point Diagnostic</h3>
          <p class="text-xs text-slate-500 leading-relaxed">Cameras, biometric sensors, touchscreen, speakers, and logic boards fully checked.</p>
        </div>

        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 hover:border-slate-200 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center text-2xl mb-4">
            <i class="ph-bold ph-file-text"></i>
          </div>
          <h3 class="font-bold text-slate-900 mb-1">Verified IMEI & Invoice</h3>
          <p class="text-xs text-slate-500 leading-relaxed">Anti-theft checked through government blacklists. Genuine ownership guaranteed.</p>
        </div>

        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 hover:border-slate-200 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center text-2xl mb-4">
            <i class="ph-bold ph-shield-check"></i>
          </div>
          <h3 class="font-bold text-slate-900 mb-1">Up to 12M Warranty</h3>
          <p class="text-xs text-slate-500 leading-relaxed">Peace of mind with hardware breakdown warranty and express customer support.</p>
        </div>

        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 hover:border-slate-200 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center text-2xl mb-4">
            <i class="ph-bold ph-hand-coins"></i>
          </div>
          <h3 class="font-bold text-slate-900 mb-1">Instant Doorstep Payout</h3>
          <p class="text-xs text-slate-500 leading-relaxed">Selling your old phone? Get instant UPI or bank transfer after doorstep physical check.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= FOOTER ================= -->
  <footer class="bg-slate-950 text-slate-400 text-xs py-12 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-2 md:grid-cols-5 gap-8 mb-8">
      <div class="col-span-2">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-8 h-8 rounded-xl bg-brand-500 flex items-center justify-center text-white font-bold">
            <i class="ph-fill ph-device-mobile text-lg"></i>
          </div>
          <span class="text-lg font-black text-white tracking-tight">RePhone</span>
        </div>
        <p class="text-slate-400 max-w-sm mb-4 leading-relaxed">
          The next-generation certified pre-owned smartphone marketplace. Transparent device grading, verified diagnostics, and reliable peer-to-peer exchanges.
        </p>
        <p class="text-slate-500 text-[11px]">&copy; 2026 RePhone Technologies Inc. All rights reserved.</p>
      </div>

      <div>
        <h4 class="text-white font-bold uppercase tracking-wider text-[11px] mb-3">Top Brands</h4>
        <ul class="space-y-2">
          <li><button onclick="setBrandFilter('Apple')" class="hover:text-white">Used Apple iPhone</button></li>
          <li><button onclick="setBrandFilter('Samsung')" class="hover:text-white">Used Samsung Galaxy</button></li>
          <li><button onclick="setBrandFilter('Google')" class="hover:text-white">Used Google Pixel</button></li>
          <li><button onclick="setBrandFilter('OnePlus')" class="hover:text-white">Used OnePlus Devices</button></li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-bold uppercase tracking-wider text-[11px] mb-3">Trust & Safety</h4>
        <ul class="space-y-2">
          <li><a href="#" class="hover:text-white">32-Point Test Protocol</a></li>
          <li><a href="#" class="hover:text-white">IMEI Blacklist Verification</a></li>
          <li><a href="#" class="hover:text-white">7-Day Refund Policy</a></li>
          <li><a href="#" class="hover:text-white">Warranty Claim Portal</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-bold uppercase tracking-wider text-[11px] mb-3">Cities Served</h4>
        <ul class="space-y-2">
          <li><span class="hover:text-white">Bengaluru (Electronic City & Indiranagar)</span></li>
          <li><span class="hover:text-white">Mumbai & Navi Mumbai</span></li>
          <li><span class="hover:text-white">Delhi NCR & Gurugram</span></li>
          <li><span class="hover:text-white">Hyderabad & Pune</span></li>
        </ul>
      </div>
    </div>
  </footer>

  <!-- ================= PRODUCT DETAILS MODAL ================= -->
  <div id="productModal" class="fixed inset-0 z-50 hidden overflow-y-auto modal-backdrop bg-slate-900/60 transition-opacity">
    <div class="min-h-screen px-4 text-center flex items-center justify-center p-0 sm:p-4">
      <div class="inline-block w-full max-w-4xl my-8 text-left align-middle transition-all transform bg-white shadow-2xl rounded-3xl overflow-hidden border border-slate-200">
        
        <!-- Modal Top Bar -->
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/70">
          <div class="flex items-center gap-2">
            <span id="modalVerifiedBadge" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-brand-50 text-brand-700 border border-brand-200">
