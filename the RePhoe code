    /* ==========================================================
       ACTIVE FILTER TAGS ROW
       ========================================================== */
    function renderActiveTags() {
      const row = document.getElementById('activeTagsRow');
      let tags = [];

      if (activeBrandFilter !== 'All') {
        tags.push({ label: `Brand: ${activeBrandFilter}`, clear: () => setBrandFilter('All') });
      }
      if (activeCityFilter !== 'All') {
        tags.push({ label: `City: ${activeCityFilter}`, clear: () => handleCityFilter('All') });
      }
      if (document.getElementById('verifiedOnlyToggle').checked) {
        tags.push({ label: 'Certified Only', clear: () => { document.getElementById('verifiedOnlyToggle').checked = false; applyFilters(); } });
      }
      const cond = document.getElementById('conditionFilterSelect').value;
      if (cond !== 'All') {
        tags.push({ label: `Condition: ${cond}`, clear: () => { document.getElementById('conditionFilterSelect').value = 'All'; applyFilters(); } });
      }
      const stor = document.getElementById('storageFilterSelect').value;
      if (stor !== 'All') {
        tags.push({ label: `Storage: ${stor}`, clear: () => { document.getElementById('storageFilterSelect').value = 'All'; applyFilters(); } });
      }
      if (searchQuery.trim() !== '') {
        tags.push({ label: `Search: "${searchQuery}"`, clear: clearSearch });
      }

      if (tags.length === 0) {
        row.classList.add('hidden');
        row.innerHTML = '';
        return;
      }

      row.classList.remove('hidden');
      row.innerHTML = tags.map((t, index) => `
        <span class="inline-flex items-center gap-1 bg-slate-200/80 text-slate-800 text-xs font-bold px-2.5 py-1 rounded-full">
          <span>${t.label}</span>
          <button onclick="window.__clearTag(${index})" class="hover:text-rose-600"><i class="ph-bold ph-x"></i></button>
        </span>
      `).join('');

      window.__clearTag = (i) => tags[i].clear();
    }

    /* ==========================================================
       PRODUCT DETAILS MODAL LOGIC
       ========================================================== */
    function openProductModal(phoneId) {
      const phone = phonesData.find(p => p.id === phoneId);
      if (!phone) return;

      selectedPhoneForModal = phone;

      // Populate details
      document.getElementById('modalTitle').innerText = phone.model;
      document.getElementById('modalBrandTag').innerText = phone.brand;
      document.getElementById('modalPrice').innerText = `₹${phone.price.toLocaleString('en-IN')}`;
      document.getElementById('modalOriginalPrice').innerText = phone.originalPrice ? `₹${phone.originalPrice.toLocaleString('en-IN')}` : '';
      
      const discount = phone.originalPrice ? Math.round(((phone.originalPrice - phone.price) / phone.originalPrice) * 100) : 0;
      document.getElementById('modalSavingsBadge').innerText = discount > 0 ? `Save ${discount}%` : 'Fair Price';

      document.getElementById('modalLocation').innerText = phone.location;
      document.getElementById('modalDate').innerText = phone.dateAdded;
      document.getElementById('modalBattery').innerText = `${phone.batteryHealth}%`;
      document.getElementById('modalStorage').innerText = phone.storage;
      document.getElementById('modalWarranty').innerText = phone.warranty.split(' ')[0] + ' ' + (phone.warranty.split(' ')[1] || 'Mo');
      document.getElementById('modalConditionScore').innerText = `${phone.conditionScore} ${phone.condition}`;
      
      // Verified badge
      const vBadge = document.getElementById('modalVerifiedBadge');
      if (phone.verified) {
        vBadge.classList.remove('hidden');
      } else {
        vBadge.classList.add('hidden');
      }

      // Seller
      document.getElementById('modalSellerName').innerText = phone.sellerName;
      document.getElementById('modalSellerAvatar').innerText = phone.sellerName.substring(0, 2).toUpperCase();
      document.getElementById('modalSellerRating').innerText = phone.sellerRating;
      document.getElementById('modalSellerType').innerText = phone.sellerType;

      // Main image & gallery thumbnails
      const mainImg = document.getElementById('modalMainImg');
      mainImg.src = phone.images[0];

      const thumbsContainer = document.getElementById('modalThumbsList');
      thumbsContainer.innerHTML = phone.images.map((img, i) => `
        <button onclick="document.getElementById('modalMainImg').src='${img}'" class="w-14 h-14 rounded-xl border-2 border-slate-200 hover:border-brand-500 overflow-hidden bg-slate-50 shrink-0">
          <img src="${img}" class="w-full h-full object-cover">
        </button>
      `).join('');

      // Box items
      const boxContainer = document.getElementById('modalBoxItems');
      boxContainer.innerHTML = (phone.boxItems || ['Device only', 'GST Invoice']).map(item => `
        <span class="bg-white border border-slate-200 px-2 py-1 rounded-lg text-[11px] font-semibold text-slate-700">
          ✓ ${item}
        </span>
      `).join('');

      updateModalFavButtonState();

      // Show modal
      document.getElementById('productModal').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeProductModal() {
      document.getElementById('productModal').classList.add('hidden');
      document.body.style.overflow = 'auto';
      selectedPhoneForModal = null;
