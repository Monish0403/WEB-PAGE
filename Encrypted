<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RouteShare | Intercity Carpooling</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <!-- Tailwind Config for Custom Colors/Fonts -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            900: '#14532d',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom styles to hide scrollbar but allow scrolling */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        .hero-pattern {
            background-color: #f8fafc;
            background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
            background-size: 24px 24px;
        }
    </style>
</head>
<body class="font-sans antialiased text-slate-800 bg-slate-50 selection:bg-brand-500 selection:text-white">

    <!-- Navigation -->
    <nav class="fixed w-full z-50 top-0 transition-all duration-300 bg-white/80 backdrop-blur-md border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <!-- Logo -->
                <div class="flex-shrink-0 flex items-center gap-2 cursor-pointer">
                    <div class="bg-brand-600 text-white p-2 rounded-xl">
                        <i class="ph ph-car-profile text-2xl"></i>
                    </div>
                    <span class="font-bold text-2xl tracking-tight text-slate-900">RouteShare</span>
                </div>
                
                <!-- Desktop Menu -->
                <div class="hidden md:flex items-center space-x-8">
                    <a href="#" class="text-slate-600 hover:text-brand-600 font-medium transition-colors flex items-center gap-2">
                        <i class="ph ph-magnifying-glass"></i> Find a ride
                    </a>
                    <a href="#" class="text-slate-600 hover:text-brand-600 font-medium transition-colors flex items-center gap-2">
                        <i class="ph ph-plus-circle"></i> Offer a ride
                    </a>
                    <div class="w-px h-6 bg-slate-300"></div>
                    <a href="#" class="text-slate-600 hover:text-slate-900 font-medium transition-colors">Log in</a>
                    <button class="bg-slate-900 hover:bg-slate-800 text-white px-5 py-2.5 rounded-full font-medium transition-all shadow-sm">
                        Sign up
                    </button>
                </div>

                <!-- Mobile Menu Button -->
                <div class="md:hidden flex items-center">
                    <button class="text-slate-600 hover:text-slate-900 focus:outline-none p-2">
                        <i class="ph ph-list text-3xl"></i>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden hero-pattern">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center max-w-3xl mx-auto mb-12">
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 leading-tight mb-6">
                    Your Intercity Journey,<br> <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-600 to-emerald-400">Shared Together.</span>
                </h1>
                <p class="text-lg md:text-xl text-slate-600 mb-8 leading-relaxed">
                    Going from Bangalore to Mysore? Don't travel with empty seats. Connect with verified passengers, share the costs, and travel comfortably.
                </p>
            </div>

            <!-- Search Interface Card -->
            <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 p-3 max-w-5xl mx-auto border border-slate-100 transform transition-all hover:shadow-2xl hover:shadow-slate-200/60">
                <form class="flex flex-col md:flex-row gap-3">
                    
                    <!-- Leaving From -->
                    <div class="relative flex-1 group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="ph-fill ph-map-pin text-slate-400 group-focus-within:text-brand-600 transition-colors text-xl"></i>
                        </div>
                        <input type="text" placeholder="Leaving from (e.g. Bangalore)" class="w-full pl-12 pr-4 py-4 bg-slate-50 border border-transparent rounded-2xl focus:bg-white focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 outline-none transition-all text-slate-900 font-medium placeholder:font-normal placeholder:text-slate-500">
                    </div>

                    <!-- Separator Icon (Hidden on mobile) -->
                    <div class="hidden md:flex items-center justify-center -mx-5 z-10">
                        <div class="bg-white p-2 rounded-full shadow-sm border border-slate-100 text-slate-400">
                            <i class="ph ph-arrows-left-right text-lg"></i>
                        </div>
                    </div>

                    <!-- Going To -->
                    <div class="relative flex-1 group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="ph-fill ph-map-pin text-slate-400 group-focus-within:text-brand-600 transition-colors text-xl"></i>
                        </div>
                        <input type="text" placeholder="Going to (e.g. Mysore)" class="w-full pl-12 pr-4 py-4 bg-slate-50 border border-transparent rounded-2xl focus:bg-white focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 outline-none transition-all text-slate-900 font-medium placeholder:font-normal placeholder:text-slate-500">
                    </div>

                    <!-- Date -->
                    <div class="relative flex-1 md:max-w-[200px] group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="ph-fill ph-calendar-blank text-slate-400 group-focus-within:text-brand-600 transition-colors text-xl"></i>
                        </div>
                        <input type="date" class="w-full pl-12 pr-4 py-4 bg-slate-50 border border-transparent rounded-2xl focus:bg-white focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 outline-none transition-all text-slate-900 font-medium">
                    </div>

                    <!-- Passengers -->
                    <div class="relative flex-1 md:max-w-[150px] group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="ph-fill ph-user text-slate-400 group-focus-within:text-brand-600 transition-colors text-xl"></i>
                        </div>
                        <select class="w-full pl-12 pr-8 py-4 bg-slate-50 border border-transparent rounded-2xl focus:bg-white focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 outline-none transition-all text-slate-900 font-medium appearance-none cursor-pointer">
                            <option>1 seat</option>
                            <option>2 seats</option>
                            <option>3 seats</option>
                            <option>4 seats</option>
                        </select>
                        <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                            <i class="ph ph-caret-down text-slate-400"></i>
                        </div>
                    </div>

                    <!-- Search Button -->
                    <button type="button" class="md:w-auto w-full bg-brand-600 hover:bg-brand-700 text-white px-8 py-4 rounded-2xl font-semibold transition-all shadow-lg shadow-brand-500/30 flex items-center justify-center gap-2">
                        <span>Search</span>
                    </button>
                </form>
            </div>
            
            <div class="mt-8 flex justify-center items-center gap-4">
