                    </ul>
                </div>

                <div>
                    <h4 class="font-bold text-slate-900 mb-4">About</h4>
                    <ul class="space-y-3">
                        <li><a href="#" class="text-slate-500 hover:text-brand-600 text-sm transition-colors">How it works</a></li>
                        <li><a href="#" class="text-slate-500 hover:text-brand-600 text-sm transition-colors">Trust & Safety</a></li>
                        <li><a href="#" class="text-slate-500 hover:text-brand-600 text-sm transition-colors">Engineering & Security</a></li>
                        <li><a href="#" class="text-slate-500 hover:text-brand-600 text-sm transition-colors">Press</a></li>
                    </ul>
                </div>

                <div>
                    <h4 class="font-bold text-slate-900 mb-4">Legal</h4>
                    <ul class="space-y-3">
                        <li><a href="#" class="text-slate-500 hover:text-brand-600 text-sm transition-colors">Terms of Service</a></li>
                        <li><a href="#" class="text-slate-500 hover:text-brand-600 text-sm transition-colors">Privacy Policy</a></li>
                        <li><a href="#" class="text-slate-500 hover:text-brand-600 text-sm transition-colors">Cookie Policy</a></li>
                        <li><a href="#" class="text-slate-500 hover:text-brand-600 text-sm transition-colors">Contact Support</a></li>
                    </ul>
                </div>
            </div>
            
            <div class="border-t border-slate-200 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
                <p class="text-slate-400 text-sm text-center md:text-left">
                    &copy; 2026 RouteShare Technologies. All rights reserved. Secured by HTTPS.
                </p>
                <div class="flex items-center gap-2 text-slate-400 text-sm">
                    <i class="ph-fill ph-lock-key"></i> 256-bit SSL Encrypted
                </div>
            </div>
        </div>
    </footer>

    <!-- Interactive JS for Sticky Header Shadow -->
    <script>
        window.addEventListener('scroll', () => {
            const nav = document.querySelector('nav');
            if (window.scrollY > 10) {
                nav.classList.add('shadow-sm');
            } else {
                nav.classList.remove('shadow-sm');
            }
        });
    </script>
</body>
</html>
