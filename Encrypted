    <!-- Why Choose Us / Quick Actions -->
    <section class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Driver Card -->
                <div class="bg-brand-50 rounded-3xl p-8 lg:p-12 relative overflow-hidden group">
                    <div class="absolute top-0 right-0 -mt-8 -mr-8 w-48 h-48 bg-brand-100 rounded-full blur-3xl opacity-50"></div>
                    <div class="relative z-10">
                        <div class="w-14 h-14 bg-white rounded-2xl shadow-sm flex items-center justify-center text-brand-600 text-2xl mb-6">
                            <i class="ph-fill ph-steering-wheel"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-slate-900 mb-4">Driving somewhere?</h2>
                        <p class="text-slate-600 mb-8 text-lg leading-relaxed">
                            Don't let those empty seats go to waste. Publish your ride in seconds, select who travels with you, and save significantly on your fuel and toll costs.
                        </p>
                        <button class="bg-brand-600 hover:bg-brand-700 text-white px-6 py-3 rounded-full font-medium transition-all shadow-md inline-flex items-center gap-2">
                            Offer a ride <i class="ph-bold ph-arrow-right"></i>
                        </button>
                    </div>
                </div>

                <!-- Passenger Card -->
                <div class="bg-blue-50 rounded-3xl p-8 lg:p-12 relative overflow-hidden group">
                    <div class="absolute top-0 right-0 -mt-8 -mr-8 w-48 h-48 bg-blue-100 rounded-full blur-3xl opacity-50"></div>
                    <div class="relative z-10">
                        <div class="w-14 h-14 bg-white rounded-2xl shadow-sm flex items-center justify-center text-blue-600 text-2xl mb-6">
                            <i class="ph-fill ph-armchair"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-slate-900 mb-4">Looking for a ride?</h2>
                        <p class="text-slate-600 mb-8 text-lg leading-relaxed">
                            Book a comfortable seat at a fraction of the cost of a cab or train. Choose from thousands of verified drivers heading your way.
                        </p>
                        <button class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-full font-medium transition-all shadow-md inline-flex items-center gap-2">
                            Find a ride <i class="ph-bold ph-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Security & Trust Section (CRITICAL FOCUS) -->
    <section class="py-24 bg-slate-900 text-white relative overflow-hidden">
