                <span class="px-3 py-1 bg-white border border-slate-200 rounded-full text-sm text-slate-600 cursor-pointer hover:border-brand-500 hover:text-brand-600 transition-colors">HYD &rarr; BLR</span>
                <span class="hidden sm:inline-block px-3 py-1 bg-white border border-slate-200 rounded-full text-sm text-slate-600 cursor-pointer hover:border-brand-500 hover:text-brand-600 transition-colors">CHE &rarr; BLR</span>
