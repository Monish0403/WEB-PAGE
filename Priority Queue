#include <stdio.h>
#define MAX 5

typedef struct {
    int data;
    int priority;
} Item;

Item pq[MAX];
int size = 0;

int isFull() {
    return size == MAX;
}

int isEmpty() {
    return size == 0;
}

void enqueue(int data, int priority) {
    if (isFull()) {
        printf("Priority Queue Overflow\n");
        return;
    }
    pq[size].data = data;
    pq[size].priority = priority;
    size++;
    printf("Enqueued: %d (Priority %d)\n", data, priority);
}

int getHighestPriorityIndex() {
    int highestIdx = 0;
    for (int i = 1; i < size; i++) {
        if (pq[i].priority > pq[highestIdx].priority) {
            highestIdx = i;
        }
    }
    return highestIdx;
}

int dequeue() {
    if (isEmpty()) {
        printf("Priority Queue Underflow\n");
        return -1;
    }
    int idx = getHighestPriorityIndex();
    int value = pq[idx].data;
    printf("Dequeued: %d (Priority %d)\n", pq[idx].data, pq[idx].priority);

    // Shift remaining elements left
    for (int i = idx; i < size - 1; i++) {
        pq[i] = pq[i + 1];
    }
    size--;
    return value;
}

void peek() {
    if (isEmpty()) {
        printf("Priority Queue is empty\n");
        return;
    }
    int idx = getHighestPriorityIndex();
    printf("Highest Priority Element: %d (Priority %d)\n", pq[idx].data, pq[idx].priority);
}

void display() {
    if (isEmpty()) {
        printf("Priority Queue is empty\n");
        return;
    }
    printf("Priority Queue [Data(Priority)]: ");
    for (int i = 0; i < size; i++) {
        printf("%d(%d) ", pq[i].data, pq[i].priority);
    }
    printf("\n");
}

int main() {
    enqueue(10, 1);
    enqueue(30, 3);
    enqueue(20, 2);
    display();
    peek();
    dequeue(); // Removes 30 (Priority 3)
    display();
    return 0;
}
