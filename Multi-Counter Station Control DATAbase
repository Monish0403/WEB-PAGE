## 2. Ready-to-Run SQL Schema (PostgreSQL / MySQL)

You can copy and run this script directly in PostgreSQL or MySQL:

```sql
-- 1. Create Counters Table
CREATE TABLE counters (
    counter_id VARCHAR(10) PRIMARY KEY, -- e.g., 'C-01'
    counter_name VARCHAR(100) NOT NULL,
    station_type VARCHAR(50) NOT NULL,  -- 'RETAIL', 'VIP', 'CORPORATE', 'EXPRESS'
    max_cash_limit NUMERIC(15, 2) DEFAULT 50000.00,
    is_active BOOLEAN DEFAULT TRUE
);

-- 2. Create Drawer Inventory (Tracks physical cash per counter)
CREATE TABLE drawer_inventory (
    inventory_id SERIAL PRIMARY KEY,
    counter_id VARCHAR(10) REFERENCES counters(counter_id) ON DELETE CASCADE,
    currency_code VARCHAR(3) NOT NULL,  -- 'USD', 'EUR', 'GBP'
    denomination_value INT NOT NULL,    -- 100, 50, 20, 10
    bill_count INT NOT NULL DEFAULT 0 CHECK (bill_count >= 0),
    last_updated TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 3. Create Customers Table
CREATE TABLE customers (
    customer_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    full_name VARCHAR(150) NOT NULL,
    id_type VARCHAR(50) NOT NULL,       -- 'PASSPORT', 'NATIONAL_ID', 'DRIVERS_LICENSE'
    id_number VARCHAR(100) NOT NULL UNIQUE,
    nationality VARCHAR(50) NOT NULL,
    risk_level VARCHAR(20) DEFAULT 'LOW' -- 'LOW', 'MEDIUM', 'HIGH'
);

-- 4. Create Transactions Table (ACID Ledger)
CREATE TABLE transactions (
    tx_id VARCHAR(20) PRIMARY KEY,      -- e.g., 'TX-89214'
    counter_id VARCHAR(10) REFERENCES counters(counter_id),
    customer_id UUID REFERENCES customers(customer_id),
    teller_username VARCHAR(100) NOT NULL,
    from_currency VARCHAR(3) NOT NULL,
    to_currency VARCHAR(3) NOT NULL,
    inbound_amount NUMERIC(15, 2) NOT NULL,
    outbound_amount NUMERIC(15, 2) NOT NULL,
    exchange_rate NUMERIC(18, 8) NOT NULL,
    fee_amount NUMERIC(10, 2) DEFAULT 0.00,
    status VARCHAR(20) DEFAULT 'COMPLETED', -- 'PENDING', 'COMPLETED', 'FLAGGED'
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 5. Create Denomination Audit Table (Tracks exact notes exchanged)
CREATE TABLE denomination_audit (
    audit_id SERIAL PRIMARY KEY,
    tx_id VARCHAR(20) REFERENCES transactions(tx_id) ON DELETE CASCADE,
    currency_code VARCHAR(3) NOT NULL,
    direction VARCHAR(5) NOT NULL,      -- 'IN' (customer gave) or 'OUT' (teller dispensed)
    denomination_val INT NOT NULL,
    notes_count INT NOT NULL
);

-- 6. Create AML / KYC Alerts Table
CREATE TABLE aml_alerts (
    alert_id SERIAL PRIMARY KEY,
    tx_id VARCHAR(20) REFERENCES transactions(tx_id),
    customer_id UUID REFERENCES customers(customer_id),
    alert_reason VARCHAR(255) NOT NULL, -- e.g., 'Threshold exceeded ($10,000+)'
    status VARCHAR(20) DEFAULT 'PENDING', -- 'PENDING', 'APPROVED', 'REJECTED'
    approved_by VARCHAR(100),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

```

